---
// Style reminder: a compact paper-and-ink language control; it should feel like a printed guide label, not a generic app setting.
// Four languages: Tiếng Việt / English / 中文 / 한국어.
---
<div class="language-switch" aria-label="Language selection"><button type="button" data-language-choice="vi" aria-pressed="true">Tiếng Việt</button><button type="button" data-language-choice="en" aria-pressed="false">English</button><button type="button" data-language-choice="zh" aria-pressed="false">中文</button><button type="button" data-language-choice="ko" aria-pressed="false">한국어</button></div>

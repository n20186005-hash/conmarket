---
// Sub-page: opening hours, best time to visit, payment and facilities for Chợ Cồn.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
export const prerender = true;
const pageUrl = Astro.site ? new URL("/gio-mo-cua-cho-con/", Astro.site).href : "https://conmarket.org/gio-mo-cua-cho-con/";
const homeUrl = Astro.site ? new URL("/", Astro.site).href : "https://conmarket.org/";
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Chợ Cồn (Con Market)", item: homeUrl },
  { "@type": "ListItem", position: 2, name: "Giờ mở cửa Chợ Cồn", item: pageUrl }
] };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: [
  { "@type": "Question", name: "Chợ Cồn mở cửa mấy giờ?", acceptedAnswer: { "@type": "Answer", text: "Khu chợ thường được ghi nhận mở cửa hàng ngày từ khoảng 06:00 đến 19:30. Giờ của từng quầy có thể khác nhau, nên kiểm tra trực tiếp khi đến. / The market is commonly listed as open daily from about 06:00 to 19:30. Individual stall hours can differ, so check on arrival. / 市场通常每日约 06:00 至 19:30 营业；各摊位时间可能不同，到店时请确认。 / 시장은 보통 매일 약 06:00~19:30 영업합니다. 가게마다 다를 수 있으니 방문 시 확인하세요." } },
  { "@type": "Question", name: "Chợ Cồn có đóng cửa vào ngày nào không?", acceptedAnswer: { "@type": "Answer", text: "Chợ không có thông tin đóng cửa cố định theo tuần; hầu hết quầy hoạt động hàng ngày, riêng một số gian có thể nghỉ theo lịch riêng. / No fixed weekly closure is listed; most stalls run daily, though a few may close on their own schedule. / 无固定按周的休市；多数摊位每日营业，少数可能按自身安排休息。 / 고정 휴무는 없으며 대부분 매일 영업하나 일부는 각자 쉴 수 있습니다." } },
  { "@type": "Question", name: "Buổi nào đông nhất?", acceptedAnswer: { "@type": "Answer", text: "Sáng sớm thường nhộn nhịp ở khu thực phẩm; giữa trưa và cuối tuần cũng đông hơn. Đi sớm giúp quan sát nhịp chợ dễ dàng hơn. / Early morning is busiest in the food section; midday and weekends are also fuller. Arriving early makes the market rhythm easier to observe. / 清晨食品区最拥挤；中午与周末也更忙。早到更容易感受市场节奏。 / 이른 아침 식료품 구역이 가장 붐비고 정오·주말도 많습니다. 일찍 가면 시장 리듬을 보기 좋습니다." } },
  { "@type": "Question", name: "Có thể thanh toán bằng thẻ ở chợ không?", acceptedAnswer: { "@type": "Answer", text: "Cách thanh toán khác nhau theo từng quầy. Nên mang tiền mặt mệnh giá nhỏ và hỏi giá trước khi gọi món hoặc mua hàng. / Payment varies by stall. Carry small-denomination cash and ask the price before ordering or buying. / 支付方式因摊位而异。请带小额现金，点餐或购买前先问价。 / 결제는 가게마다 다릅니다. 소액 현금을 준비하고 주문·구매 전 가격을 물어보세요." } },
  { "@type": "Question", name: "Chợ Cồn có mở ngày lễ, Tết không?", acceptedAnswer: { "@type": "Answer", text: "Vào các dịp lễ, Tết, giờ và số quầy mở cửa có thể thay đổi. Hãy xác minh trực tiếp hoặc qua nguồn chính thức ngay trước chuyến đi. / Around public holidays, hours and the number of open stalls can change. Verify directly or via official sources right before visiting. / 节假日期间营业时间与开市摊位数可能变化，请出行前直接核实或查官方来源。 / 공휴일에는 시간과 열리는 가게 수가 바뀔 수 있습니다. 방문 전 직접 또는 공식 자료로 확인하세요." } }
] };
---
<BaseLayout title="Giờ mở cửa Chợ Cồn Đà Nẵng — Hướng dẫn" description="Giờ mở cửa thường thấy, thời điểm nên đi, thanh toán và tiện ích tại Chợ Cồn (Con Market) Đà Nẵng — hướng dẫn thực tế, trung lập." titleEn="Chợ Cồn (Con Market) Đà Nẵng — Opening hours" descriptionEn="Commonly listed hours, best time to visit, payment and facilities at Chợ Cồn (Con Market) Đà Nẵng — neutral, practical guidance." titleZh="岘港昆市场营业时间 — 指南" descriptionZh="岘港昆市场（Con Market）的通常营业时间、最佳到访时间与支付、设施——中立实用指南（越/英/中/韩）。" titleKo="다낭 꼰 시장 영업 시간 — 가이드" descriptionKo="다낭 꼰 시장(Con Market)의 일반 영업 시간·방문 적기·결제·편의시설 — 중립적 실용 안내.">
  <header class="guide-hero"><div class="topbar"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="44" height="44" /><span class="brand-name">CHỢ CỒN</span></a><LanguageSwitch /></div><div class="section-shell"><p class="eyebrow"><span class="lang-vi">Thông tin thực tế</span><span class="lang-en">Practical info</span><span class="lang-zh">实用信息</span><span class="lang-ko">실용 정보</span></p><h1 class="display"><span class="lang-vi">Giờ mở cửa Chợ Cồn</span><span class="lang-en">Chợ Cồn opening hours</span><span class="lang-zh">昆市场营业时间</span><span class="lang-ko">꼰 시장 영업 시간</span></h1><p class="intro-text"><span class="lang-vi">Chợ Cồn là chợ truyền thống đang vận hành thật, nên giờ của từng khu hàng có thể khác nhau. Dưới đây là khung tham khảo để bạn sắp xếp chuyến đi.</span><span class="lang-en">Con Market is a working traditional market, so hours vary by section. The notes below are a reference frame for planning your visit.</span><span class="lang-zh">昆市场是真实运转的传统市场，各区域营业时间可能不同。以下为安排行程的参考框架。</span><span class="lang-ko">꼰 시장은 실제 운영되는 전통 시장이라 구역마다 시간이 다를 수 있습니다. 아래는 동선 계획을 위한 참고 틀입니다.</span></p><a class="guide-back" href="/"><span class="lang-vi">← Trở về hướng dẫn chính</span><span class="lang-en">← Return to main guide</span><span class="lang-zh">← 返回主指南</span><span class="lang-ko">← 메인 가이드로</span></a></div></header>
  <main class="guide-body">
    <section class="section-shell" aria-labelledby="hours-title">
      <div><p class="section-index">01 —</p><p class="eyebrow"><span class="lang-vi">Giờ & nhịp điệu</span><span class="lang-en">Hours & rhythm</span><span class="lang-zh">时间与节奏</span><span class="lang-ko">시간과 리듬</span></p></div>
      <div>
        <h2 id="hours-title" class="display section-title"><span class="lang-vi">Sắp xếp thời gian ghé chợ</span><span class="lang-en">Plan your market timing</span><span class="lang-zh">安排逛市场的时间</span><span class="lang-ko">시장 방문 시간 계획</span></h2>
        <div class="field-guide">
          <article class="field-card"><span class="card-number">01</span><h3><span class="lang-vi">Giờ thường thấy</span><span class="lang-en">Commonly listed hours</span><span class="lang-zh">通常营业时间</span><span class="lang-ko">일반 영업 시간</span></h3><p class="lang-vi">Khu chợ thường được ghi nhận mở cửa hàng ngày từ khoảng 06:00 đến 19:30.</p><p class="lang-en">The market is commonly listed as open daily from about 06:00 to 19:30.</p><p class="lang-zh">市场通常每日约 06:00 至 19:30 营业。</p><p class="lang-ko">시장은 보통 매일 약 06:00~19:30 영업합니다.</p></article>
          <article class="field-card"><span class="card-number">02</span><h3><span class="lang-vi">Giờ theo khu vực</span><span class="lang-en">Hours by section</span><span class="lang-zh">按区域时间</span><span class="lang-ko">구역별 시간</span></h3><p class="lang-vi">Khu thực phẩm và ăn uống nhộn nhịp từ sớm; hàng khô, vải vóc mở suốt ngày; một số quầy đóng theo lịch riêng.</p><p class="lang-en">Food and eating areas are busy from early; dried goods and fabrics run through the day; some stalls close on their own schedule.</p><p class="lang-zh">食品与饮食区清晨便热闹；干货、布艺全天营业；部分摊位按自身安排打烊。</p><p class="lang-ko">식료품·식사 구역은 이른 아침부터 붐비고, 건어물·직물은 종일 영업, 일부 가게는 각자 시간에 문을 닫습니다.</p></article>
          <article class="field-card"><span class="card-number">03</span><h3><span class="lang-vi">Thời điểm nên đi</span><span class="lang-en">Best time to go</span><span class="lang-zh">最佳到访时间</span><span class="lang-ko">방문 적기</span></h3><p class="lang-vi">Sáng sớm (06:00–09:00) hợp quan sát khu thực phẩm; trưa cân bằng; chiều linh hoạt nhưng nắng hơn.</p><p class="lang-en">Early morning (06:00–09:00) suits the food trade; midday is balanced; afternoon is flexible but hotter.</p><p class="lang-zh">清晨（06:00–09:00）适合看食品交易；中午均衡；下午灵活但更晒。</p><p class="lang-ko">이른 아침(06:00~09:00)은 식료품 장사 보기에 좋고, 정오는 균형, 오후는 유연하나 더웁니다.</p></article>
          <article class="field-card"><span class="card-number">04</span><h3><span class="lang-vi">Thanh toán</span><span class="lang-en">Payment</span><span class="lang-zh">支付</span><span class="lang-ko">결제</span></h3><p class="lang-vi">Mỗi quầy tự định giá. Tiền mặt mệnh giá nhỏ thuận tiện; thẻ tùy từng quầy.</p><p class="lang-en">Each stall sets its own price. Small cash is handy; cards depend on the stall.</p><p class="lang-zh">各摊位自定价。小额现金方便；刷卡视摊位而定。</p><p class="lang-ko">가게마다 가격이 다릅니다. 소액 현금이 편리하며 카드는 가게에 따라 다릅니다.</p></article>
          <article class="field-card"><span class="card-number">05</span><h3><span class="lang-vi">Tiện ích</span><span class="lang-en">Facilities</span><span class="lang-zh">设施</span><span class="lang-ko">편의시설</span></h3><p class="lang-vi">Nhà vệ sinh và khu gửi xe có thể nằm trong/ngoài chợ; hỏi nhân viên hoặc biển chỉ dẫn khi cần.</p><p class="lang-en">Restrooms and parking may be inside or near the market; ask staff or follow signs when needed.</p><p class="lang-zh">洗手间与停车区可能在市场内或附近；需要时询问工作人员或看指示牌。</p><p class="lang-ko">화장실과 주차는 시장 안팎에 있을 수 있으니 필요 시 직원이나 안내판을 참고하세요.</p></article>
          <article class="field-card"><span class="card-number">06</span><h3><span class="lang-vi">Tiếp cận</span><span class="lang-en">Access</span><span class="lang-zh">无障碍</span><span class="lang-ko">접근성</span></h3><p class="lang-vi">Mặt bằng, bậc thềm và lối đi thay đổi theo khu. Người cần hỗ trợ nên đi cùng người đồng hành.</p><p class="lang-en">Surfaces, steps and aisle widths vary by section. Visitors needing help should bring a companion.</p><p class="lang-zh">地面、台阶与通道宽度因区域而异。需要协助者请结伴。</p><p class="lang-ko">바닥·계단·통로 폭은 구역마다 다릅니다. 도움이 필요하면 동행하세요.</p></article>
        </div>
        <p class="intro-text lang-vi">Chúng tôi không có thông tin về vé cổng; bất kỳ chi phí nào phát sinh đều đến từ món ăn, hàng hóa hoặc dịch vụ bạn tự chọn. Hãy xác minh giờ và tiện ích dễ thay đổi ngay trước chuyến đi.</p>
        <p class="intro-text lang-en">We list no gate ticket; any cost comes from food, goods or services you choose. Verify changeable hours and facilities right before you go.</p>
        <p class="intro-text lang-zh">我们不提供门票信息；任何花费均来自你自选的食品、商品或服务。出行前请核实易变的营业时间与设施。</p>
        <p class="intro-text lang-ko">입장료 정보는 없으며 비용은 직접 선택한 음식·상품·서비스에 따릅니다. 변동 가능한 시간·편의시설은 출발 전 확인하세요.</p>
      </div>
    </section>
    <section class="faq" aria-labelledby="faq-title"><div class="section-shell"><div><p class="section-index">02 —</p><p class="eyebrow"><span class="lang-vi">Câu hỏi thường gặp</span><span class="lang-en">FAQ</span><span class="lang-zh">常见问题</span><span class="lang-ko">자주 묻는 질문</span></p></div><div><h2 id="faq-title" class="display section-title"><span class="lang-vi">Về giờ mở cửa & tiện ích</span><span class="lang-en">On hours & facilities</span><span class="lang-zh">关于营业时间与设施</span><span class="lang-ko">영업 시간과 편의시설</span></h2><div class="faq-list"><details><summary><span class="lang-vi">Chợ Cồn mở cửa mấy giờ?</span><span class="lang-en">What are Chợ Cồn's opening hours?</span><span class="lang-zh">昆市场几点营业？</span><span class="lang-ko">꼰 시장은 몇 시에 영업하나요?</span></summary><div class="answer"><p class="lang-vi">Khu chợ thường được ghi nhận mở cửa hàng ngày từ khoảng 06:00 đến 19:30. Giờ của từng quầy có thể khác nhau, nên kiểm tra trực tiếp khi đến.</p><p class="lang-en">The market is commonly listed as open daily from about 06:00 to 19:30. Individual stall hours can differ, so check on arrival.</p><p class="lang-zh">市场通常每日约 06:00 至 19:30 营业；各摊位时间可能不同，到店时请确认。</p><p class="lang-ko">시장은 보통 매일 약 06:00~19:30 영업합니다. 가게마다 다를 수 있으니 방문 시 확인하세요.</p></div></details><details><summary><span class="lang-vi">Chợ Cồn có đóng cửa vào ngày nào không?</span><span class="lang-en">Is the market closed on any day?</span><span class="lang-zh">昆市场有固定休市日吗？</span><span class="lang-ko">꼰 시장은 쉬는 날이 있나요?</span></summary><div class="answer"><p class="lang-vi">Chợ không có thông tin đóng cửa cố định theo tuần; hầu hết quầy hoạt động hàng ngày, riêng một số gian có thể nghỉ theo lịch riêng.</p><p class="lang-en">No fixed weekly closure is listed; most stalls run daily, though a few may close on their own schedule.</p><p class="lang-zh">无固定按周的休市；多数摊位每日营业，少数可能按自身安排休息。</p><p class="lang-ko">고정 휴무는 없으며 대부분 매일 영업하나 일부는 각자 쉴 수 있습니다.</p></div></details><details><summary><span class="lang-vi">Buổi nào đông nhất?</span><span class="lang-en">When is it busiest?</span><span class="lang-zh">哪个时段最拥挤？</span><span class="lang-ko">언제 가장 붐비나요?</span></summary><div class="answer"><p class="lang-vi">Sáng sớm thường nhộn nhịp ở khu thực phẩm; giữa trưa và cuối tuần cũng đông hơn. Đi sớm giúp quan sát nhịp chợ dễ dàng hơn.</p><p class="lang-en">Early morning is busiest in the food section; midday and weekends are also fuller. Arriving early makes the market rhythm easier to observe.</p><p class="lang-zh">清晨食品区最拥挤；中午与周末也更忙。早到更容易感受市场节奏。</p><p class="lang-ko">이른 아침 식료품 구역이 가장 붐비고 정오·주말도 많습니다. 일찍 가면 시장 리듬을 보기 좋습니다.</p></div></details><details><summary><span class="lang-vi">Có thể thanh toán bằng thẻ ở chợ không?</span><span class="lang-en">Can I pay by card at the market?</span><span class="lang-zh">市场内能刷卡吗？</span><span class="lang-ko">시장에서 카드 결제가 되나요?</span></summary><div class="answer"><p class="lang-vi">Cách thanh toán khác nhau theo từng quầy. Nên mang tiền mặt mệnh giá nhỏ và hỏi giá trước khi gọi món hoặc mua hàng.</p><p class="lang-en">Payment varies by stall. Carry small-denomination cash and ask the price before ordering or buying.</p><p class="lang-zh">支付方式因摊位而异。请带小额现金，点餐或购买前先问价。</p><p class="lang-ko">결제는 가게마다 다릅니다. 소액 현금을 준비하고 주문·구매 전 가격을 물어보세요.</p></div></details><details><summary><span class="lang-vi">Chợ Cồn có mở ngày lễ, Tết không?</span><span class="lang-en">Is it open on public holidays?</span><span class="lang-zh">节假日昆市场营业吗？</span><span class="lang-ko">공휴일에도 영업하나요?</span></summary><div class="answer"><p class="lang-vi">Vào các dịp lễ, Tết, giờ và số quầy mở cửa có thể thay đổi. Hãy xác minh trực tiếp hoặc qua nguồn chính thức ngay trước chuyến đi.</p><p class="lang-en">Around public holidays, hours and the number of open stalls can change. Verify directly or via official sources right before visiting.</p><p class="lang-zh">节假日期间营业时间与开市摊位数可能变化，请出行前直接核实或查官方来源。</p><p class="lang-ko">공휴일에는 시간과 열리는 가게 수가 바뀔 수 있습니다. 방문 전 직접 또는 공식 자료로 확인하세요.</p></div></details></div></div></div></section>

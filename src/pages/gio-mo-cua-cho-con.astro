---
// Sub-page: opening hours, best time to visit, payment and facilities for Chợ Cồn.
// Deeper, standalone topic page to broaden indexed surface and capture long-tail queries.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
export const prerender = true;
const pageUrl = Astro.site ? new URL("/gio-mo-cua-cho-con/", Astro.site).href : "https://conmarket.org/gio-mo-cua-cho-con/";
const homeUrl = Astro.site ? new URL("/", Astro.site).href : "https://conmarket.org/";
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Chợ Cồn (Con Market)", item: homeUrl },
  { "@type": "ListItem", position: 2, name: "Giờ mở cửa Chợ Cồn", item: pageUrl }
] };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: [
  { "@type": "Question", name: "Chợ Cồn mở cửa mấy giờ?", acceptedAnswer: { "@type": "Answer", text: "Khu chợ thường được ghi nhận mở cửa hàng ngày từ khoảng 06:00 đến 19:30. Giờ của từng quầy có thể khác nhau, nên kiểm tra trực tiếp khi đến. / The market is commonly listed as open daily from about 06:00 to 19:30. Individual stall hours can differ, so check on arrival." } },
  { "@type": "Question", name: "Chợ Cồn có đóng cửa vào ngày nào không?", acceptedAnswer: { "@type": "Answer", text: "Chợ không có thông tin đóng cửa cố định theo tuần; hầu hết quầy hoạt động hàng ngày, riêng một số gian có thể nghỉ theo lịch riêng. / No fixed weekly closure is listed; most stalls run daily, though a few may close on their own schedule." } },
  { "@type": "Question", name: "Buổi nào đông nhất?", acceptedAnswer: { "@type": "Answer", text: "Sáng sớm thường nhộn nhịp ở khu thực phẩm; giữa trưa và cuối tuần cũng đông hơn. Đi sớm giúp quan sát nhịp chợ dễ dàng hơn. / Early morning is busiest in the food section; midday and weekends are also fuller. Arriving early makes the market rhythm easier to observe." } },
  { "@type": "Question", name: "Có thể thanh toán bằng thẻ ở chợ không?", acceptedAnswer: { "@type": "Answer", text: "Cách thanh toán khác nhau theo từng quầy. Nên mang tiền mặt mệnh giá nhỏ và hỏi giá trước khi gọi món hoặc mua hàng. / Payment varies by stall. Carry small-denomination cash and ask the price before ordering or buying." } },
  { "@type": "Question", name: "Chợ Cồn có mở ngày lễ, Tết không?", acceptedAnswer: { "@type": "Answer", text: "Vào các dịp lễ, Tết, giờ và số quầy mở cửa có thể thay đổi. Hãy xác minh trực tiếp hoặc qua nguồn chính thức ngay trước chuyến đi. / Around public holidays, hours and the number of open stalls can change. Verify directly or via official sources right before visiting." } }
] };
---
<BaseLayout title="Giờ mở cửa Chợ Cồn Đà Nẵng — Hướng dẫn" description="Giờ mở cửa thường thấy, thời điểm nên đi, thanh toán và tiện ích tại Chợ Cồn (Con Market) Đà Nẵng — hướng dẫn thực tế, trung lập." canonicalPath="/gio-mo-cua-cho-con/">
  <header class="guide-hero"><div class="topbar"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="44" height="44" /><span class="brand-name">CHỢ CỒN</span></a><LanguageSwitch /></div><div class="section-shell"><p class="eyebrow">Thông tin thực tế</p><h1 class="display"><span class="lang-vi">Giờ mở cửa Chợ Cồn</span><span class="lang-en">Chợ Cồn opening hours</span></h1><p class="intro-text"><span class="lang-vi">Chợ Cồn là chợ truyền thống đang vận hành thật, nên giờ của từng khu hàng có thể khác nhau. Dưới đây là khung tham khảo để bạn sắp xếp chuyến đi.</span><span class="lang-en">Chợ Cồn is a working traditional market, so hours vary by section. The notes below are a reference frame for planning your visit.</span></p><a class="guide-back" href="/"><span class="lang-vi">← Trở về hướng dẫn chính</span><span class="lang-en">← Return to main guide</span></a></div></header>
  <main class="guide-body">
    <section class="section-shell" aria-labelledby="hours-title">
      <div><p class="section-index">01 —</p><p class="eyebrow">Giờ & nhịp điệu</p></div>
      <div>
        <h2 id="hours-title" class="display section-title"><span class="lang-vi">Sắp xếp thời gian ghé chợ</span><span class="lang-en">Plan your market timing</span></h2>
        <div class="field-guide">
          <article class="field-card"><span class="card-number">01</span><h3><span class="lang-vi">Giờ thường thấy</span><span class="lang-en">Commonly listed hours</span></h3><p class="lang-vi">Khu chợ thường được ghi nhận mở cửa hàng ngày từ khoảng 06:00 đến 19:30.</p><p class="lang-en">The market is commonly listed as open daily from about 06:00 to 19:30.</p></article>
          <article class="field-card"><span class="card-number">02</span><h3><span class="lang-vi">Giờ theo khu vực</span><span class="lang-en">Hours by section</span></h3><p class="lang-vi">Khu thực phẩm và ăn uống nhộn nhịp từ sớm; hàng khô, vải vóc mở suốt ngày; một số quầy đóng theo lịch riêng.</p><p class="lang-en">Food and eating areas are busy from early; dried goods and fabrics run through the day; some stalls close on their own schedule.</p></article>
          <article class="field-card"><span class="card-number">03</span><h3><span class="lang-vi">Thời điểm nên đi</span><span class="lang-en">Best time to go</span></h3><p class="lang-vi">Sáng sớm (06:00–09:00) hợp quan sát khu thực phẩm; trưa cân bằng; chiều linh hoạt nhưng nắng hơn.</p><p class="lang-en">Early morning (06:00–09:00) suits the food trade; midday is balanced; afternoon is flexible but hotter.</p></article>
          <article class="field-card"><span class="card-number">04</span><h3><span class="lang-vi">Thanh toán</span><span class="lang-en">Payment</span></h3><p class="lang-vi">Mỗi quầy tự định giá. Tiền mặt mệnh giá nhỏ thuận tiện; thẻ tùy từng quầy.</p><p class="lang-en">Each stall sets its own price. Small cash is handy; cards depend on the stall.</p></article>
          <article class="field-card"><span class="card-number">05</span><h3><span class="lang-vi">Tiện ích</span><span class="lang-en">Facilities</span></h3><p class="lang-vi">Nhà vệ sinh và khu gửi xe có thể nằm trong/ngoài chợ; hỏi nhân viên hoặc biển chỉ dẫn khi cần.</p><p class="lang-en">Restrooms and parking may be inside or near the market; ask staff or follow signs when needed.</p></article>
          <article class="field-card"><span class="card-number">06</span><h3><span class="lang-vi">Tiếp cận</span><span class="lang-en">Access</span></h3><p class="lang-vi">Mặt bằng, bậc thềm và lối đi thay đổi theo khu. Người cần hỗ trợ nên đi cùng người đồng hành.</p><p class="lang-en">Surfaces, steps and aisle widths vary by section. Visitors needing help should bring a companion.</p></article>
        </div>
        <p class="intro-text lang-vi">Chúng tôi không có thông tin về vé cổng; bất kỳ chi phí nào phát sinh đều đến từ món ăn, hàng hóa hoặc dịch vụ bạn tự chọn. Hãy xác minh giờ và tiện ích dễ thay đổi ngay trước chuyến đi.</p>
        <p class="intro-text lang-en">We list no gate ticket; any cost comes from food, goods or services you choose. Verify changeable hours and facilities right before you go.</p>
      </div>
    </section>
    <section class="faq" aria-labelledby="faq-title"><div class="section-shell"><div><p class="section-index">02 —</p><p class="eyebrow">Câu hỏi thường gặp</p></div><div><h2 id="faq-title" class="display section-title"><span class="lang-vi">Về giờ mở cửa & tiện ích</span><span class="lang-en">On hours & facilities</span></h2><div class="faq-list"><details><summary><span class="lang-vi">Chợ Cồn mở cửa mấy giờ?</span><span class="lang-en">What are Chợ Cồn's opening hours?</span></summary><div class="answer"><p class="lang-vi">Khu chợ thường được ghi nhận mở cửa hàng ngày từ khoảng 06:00 đến 19:30. Giờ của từng quầy có thể khác nhau, nên kiểm tra trực tiếp khi đến.</p><p class="lang-en">The market is commonly listed as open daily from about 06:00 to 19:30. Individual stall hours can differ, so check on arrival.</p></div></details><details><summary><span class="lang-vi">Chợ Cồn có đóng cửa vào ngày nào không?</span><span class="lang-en">Is the market closed on any day?</span></summary><div class="answer"><p class="lang-vi">Chợ không có thông tin đóng cửa cố định theo tuần; hầu hết quầy hoạt động hàng ngày, riêng một số gian có thể nghỉ theo lịch riêng.</p><p class="lang-en">No fixed weekly closure is listed; most stalls run daily, though a few may close on their own schedule.</p></div></details><details><summary><span class="lang-vi">Buổi nào đông nhất?</span><span class="lang-en">When is it busiest?</span></summary><div class="answer"><p class="lang-vi">Sáng sớm thường nhộn nhịp ở khu thực phẩm; giữa trưa và cuối tuần cũng đông hơn. Đi sớm giúp quan sát nhịp chợ dễ dàng hơn.</p><p class="lang-en">Early morning is busiest in the food section; midday and weekends are also fuller. Arriving early makes the market rhythm easier to observe.</p></div></details><details><summary><span class="lang-vi">Có thể thanh toán bằng thẻ ở chợ không?</span><span class="lang-en">Can I pay by card at the market?</span></summary><div class="answer"><p class="lang-vi">Cách thanh toán khác nhau theo từng quầy. Nên mang tiền mặt mệnh giá nhỏ và hỏi giá trước khi gọi món hoặc mua hàng.</p><p class="lang-en">Payment varies by stall. Carry small-denomination cash and ask the price before ordering or buying.</p></div></details><details><summary><span class="lang-vi">Chợ Cồn có mở ngày lễ, Tết không?</span><span class="lang-en">Is it open on public holidays?</span></summary><div class="answer"><p class="lang-vi">Vào các dịp lễ, Tết, giờ và số quầy mở cửa có thể thay đổi. Hãy xác minh trực tiếp hoặc qua nguồn chính thức ngay trước chuyến đi.</p><p class="lang-en">Around public holidays, hours and the number of open stalls can change. Verify directly or via official sources right before visiting.</p></div></details></div></div></div></section>
    <section class="nearby" aria-labelledby="more-title"><div class="section-shell"><div><p class="section-index">03 —</p><p class="eyebrow" style="color:#F3B23C">Đọc sâu hơn</p></div><div><h2 id="more-title" class="display section-title"><span class="lang-vi">Các hướng dẫn chi tiết khác</span><span class="lang-en">More detailed guides</span></h2></div></div><div class="nearby-grid"><article class="nearby-item"><small><span class="lang-vi">Món ăn</span><span class="lang-en">Food</span></small><h3><span class="lang-vi">Ăn gì ở Chợ Cồn</span><span class="lang-en">What to eat at Chợ Cồn</span></h3><p class="lang-vi">Các loại hình ẩm thực theo gian hàng, trung lập và không đề xuất quầy cụ thể.</p><p class="lang-en">Food types by stall, neutral and naming no specific stall.</p><a href="/mon-an-cho-con/"><span class="lang-vi">Xem hướng dẫn ăn uống</span><span class="lang-en">See the food guide</span> ↗</a></article><article class="nearby-item"><small><span class="lang-vi">Di chuyển</span><span class="lang-en">Getting there</span></small><h3><span class="lang-vi">Đường đi Chợ Cồn</span><span class="lang-en">How to reach Chợ Cồn</span></h3><p class="lang-vi">Từ sân bay, xe buýt, taxi và đi bộ — hướng dẫn theo từng xuất phát.</p><p class="lang-en">From the airport, bus, taxi and on foot — directions by origin.</p><a href="/duong-di-cho-con/"><span class="lang-vi">Xem hướng dẫn di chuyển</span><span class="lang-en">See directions</span> ↗</a></article><article class="nearby-item"><small><span class="lang-vi">Trang chính</span><span class="lang-en">Main guide</span></small><h3><span class="lang-vi">Hướng dẫn Chợ Cồn</span><span class="lang-en">Chợ Cồn guide</span></h3><p class="lang-vi">Tổng quan lịch sử, thời tiết, tiện ích và trách nhiệm tham quan.</p><p class="lang-en">Overview of history, weather, facilities and visiting responsibly.</p><a href="/"><span class="lang-vi">Về hướng dẫn chính</span><span class="lang-en">Back to main guide</span> ↗</a></article></div></section>
  </main><SiteFooter /><script is:inline type="application/ld+json" set:html={JSON.stringify([breadcrumb, faqSchema])}></script>
</BaseLayout>

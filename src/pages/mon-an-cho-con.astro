---
// Sub-page: what to eat at Chợ Cồn, described by stall type (neutral, no specific-stall endorsement).
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
export const prerender = true;
const pageUrl = Astro.site ? new URL("/mon-an-cho-con/", Astro.site).href : "https://conmarket.org/mon-an-cho-con/";
const homeUrl = Astro.site ? new URL("/", Astro.site).href : "https://conmarket.org/";
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Chợ Cồn (Con Market)", item: homeUrl },
  { "@type": "ListItem", position: 2, name: "Ăn gì ở Chợ Cồn", item: pageUrl }
] };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: [
  { "@type": "Question", name: "Chợ Cồn có nhiều món ăn không?", acceptedAnswer: { "@type": "Answer", text: "Có các quầy ăn, khu thực phẩm tươi và gian gia vị bên trong chợ. Chúng tôi mô tả theo dạng trải nghiệm, không đề xuất quầy cụ thể. / The market includes food stalls, fresh-food and spice sections. This guide describes experience types rather than recommending specific stalls. / 市场内有餐饮摊位、生鲜与香料区。本指南按体验类型描述，不推荐具体摊位。 / 시장 안에는 식당·식료품·향신료 구역이 있습니다. 이 가이드는 체험 유형만 안내하며 특정 가게를 추천하지 않습니다." } },
  { "@type": "Question", name: "Giá món ăn ở chợ thế nào?", acceptedAnswer: { "@type": "Answer", text: "Giá do từng quầy tự định và thường theo khẩu phần hoặc theo cân. Hỏi giá trước khi gọi món để thuận tiện cho cả hai bên. / Prices are set per stall, usually by portion or by weight. Ask before ordering so both sides are clear. / 价格由摊位自定，通常按份或按重量。点餐前问价，双方都清楚。 / 가격은 가게마다 다르며 보통 1인분 또는 중량 단위입니다. 주문 전 가격을 물어보세요." } },
  { "@type": "Question", name: "Có an toàn khi ăn ở chợ không?", acceptedAnswer: { "@type": "Answer", text: "Nên chọn quầy đông khách, quan sát chế biến và hỏi thành phần nếu bạn có dị ứng hoặc chế độ ăn riêng. / Prefer busy stalls, watch preparation and ask ingredients if you have allergies or dietary needs. / 优先人气摊位、观察制作过程，有过敏或特殊饮食请询问成分。 / 손님 많은 가게를 고르고 조리 과정을 지켜보며 알레르기나 식이 제한이 있으면 재료를 물어보세요." } },
  { "@type": "Question", name: "Có chỗ ngồi ăn tại chợ không?", acceptedAnswer: { "@type": "Answer", text: "Nhiều quầy ăn chế biến tại chỗ có chỗ ngồi đơn giản; không gian có thể đông vào giờ cao điểm. / Many prepared-food stalls have simple seating; it can be busy at peak times. / 许多现做摊位有简易座位；高峰时段可能拥挤。 / 많은 조리 가게에 간단한 좌석이 있으나 피크타임엔 붐빌 수 있습니다." } },
  { "@type": "Question", name: "Món nào nên thử trước?", acceptedAnswer: { "@type": "Answer", text: "Tuỳ sở thích, bạn có thể bắt đầu từ bún, bánh xèo, chè hoặc các món ăn vặt miền Trung. Chúng tôi chỉ gợi ý dạng món, không xếp hạng quầy. / By preference, you might start with bún, bánh xèo, chè or Central-Vietnam snacks. We suggest dish types, not ranked stalls. / 按喜好，可从米线、煎饼、甜品或中部小吃开始。我们只建议类型，不排摊位名次。 / 취향에 따라 쌀국수·녹두전·단팥·중부 간식부터 시작하세요. 우리는 유형만 제안하며 순위는 매기지 않습니다." } }
] };
---
<BaseLayout title="Ăn gì ở Chợ Cồn Đà Nẵng — Hướng dẫn món" description="Thực phẩm và món ăn tại Chợ Cồn (Con Market) Đà Nẵng: các loại hình ẩm thực theo gian hàng, vệ sinh và lưu ý, hoàn toàn trung lập." titleEn="What to eat at Chợ Cồn Đà Nẵng — Food guide" descriptionEn="Food and dishes at Chợ Cồn (Con Market) in Đà Nẵng: food types by stall, hygiene notes, fully neutral." titleZh="岘港昆市场吃什么 — 美食指南" descriptionZh="岘港昆市场（Con Market）的食品与美食指南：按摊位类型介绍，中立不推具体摊位（越/英/中/韩）。" titleKo="다낭 꼰 시장 무엇을 먹을까 — 음식 가이드" descriptionKo="다낭 꼰 시장(Con Market)의 음식 가이드: 가게 유형별 안내, 중립적(베트남어·영어·중국어·한국어).">
  <header class="guide-hero"><div class="topbar"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="44" height="44" /><span class="brand-name">CHỢ CỒN</span></a><LanguageSwitch /></div><div class="section-shell"><p class="eyebrow"><span class="lang-vi">Ẩm thực quanh chợ</span><span class="lang-en">Food around the market</span><span class="lang-zh">市场周边美食</span><span class="lang-ko">시장 주변 음식</span></p><h1 class="display"><span class="lang-vi">Ăn gì ở Chợ Cồn</span><span class="lang-en">What to eat at Chợ Cồn</span><span class="lang-zh">昆市场吃什么</span><span class="lang-ko">꼰 시장 무엇을 먹을까</span></h1><p class="intro-text"><span class="lang-vi">Chợ Cồn thường được nhắc tới cùng văn hóa ăn vặt và nguyên liệu địa phương. Chúng tôi chỉ giới thiệu dạng trải nghiệm để giữ thông tin trung lập.</span><span class="lang-en">Con Market is commonly associated with local snacks and ingredients. To stay neutral, we describe types of experiences rather than name stalls.</span><span class="lang-zh">昆市场常与当地小吃和食材联系在一起。为保持中立，我们只介绍体验类型，不点名摊位。</span><span class="lang-ko">꼰 시장은 현지 간식과 식재료로 알려져 있습니다. 중립을 위해 특정 가게를 지목하지 않고 체험 유형만 안내합니다.</span></p><a class="guide-back" href="/"><span class="lang-vi">← Trở về hướng dẫn chính</span><span class="lang-en">← Return to main guide</span><span class="lang-zh">← 返回主指南</span><span class="lang-ko">← 메인 가이드로</span></a></div></header>
  <main class="guide-body">
    <section class="section-shell" aria-labelledby="food-title">
      <div><p class="section-index">01 —</p><p class="eyebrow"><span class="lang-vi">Theo gian hàng</span><span class="lang-en">By stall type</span><span class="lang-zh">按摊位类型</span><span class="lang-ko">가게 유형별</span></p></div>
      <div>
        <h2 id="food-title" class="display section-title"><span class="lang-vi">Tìm hiểu theo nhóm món</span><span class="lang-en">Explore by food type</span><span class="lang-zh">按食物类型了解</span><span class="lang-ko">음식 유형별로 살펴보기</span></h2>
        <p class="intro-text lang-vi">Dưới đây là các dạng ẩm thực thường gặp trong chợ. Giá và món cụ thể thay đổi theo từng quầy và mùa.</p>
        <p class="intro-text lang-en">Below are common food types found in the market. Prices and specific dishes vary by stall and season.</p>
        <p class="intro-text lang-zh">以下是市场常见的食物类型。具体菜品与价格因摊位和季节而异。</p>
        <p class="intro-text lang-ko">아래는 시장에서 흔히 볼 수 있는 음식 유형입니다. 가격과 구체적 요리는 가게와 계절에 따라 다릅니다.</p>
        <div class="food-list">
          <article class="food-item"><b>01</b><div><h3><span class="lang-vi">Khu món ăn chế biến tại chỗ</span><span class="lang-en">Prepared-food area</span><span class="lang-zh">现做餐饮区</span><span class="lang-ko">조리 식사 구역</span></h3><p class="lang-vi">Phù hợp gọi phần nhỏ, ăn tại chỗ. Có thể gặp các món bún, bánh xèo, chè, ốc và ăn vặt miền Trung tuỳ quầy.</p><p class="lang-en">Good for small, eat-on-site portions. You may find bún, bánh xèo, chè, snails and Central-Vietnam snacks depending on the stall.</p><p class="lang-zh">适合点小份、就地用餐。视摊位不同可有米线、煎饼、甜品、螺与中部小吃。</p><p class="lang-ko">소량 즉석 식사에 좋습니다. 가게에 따라 쌀국수, 녹두전, 단팥, 복족류, 중부 베트남 간식을 만날 수 있습니다.</p></div></article>
          <article class="food-item"><b>02</b><div><h3><span class="lang-vi">Đồ khô, gia vị & đóng gói</span><span class="lang-en">Dried goods, spices & packaged</span><span class="lang-zh">干货、香料与包装食品</span><span class="lang-ko">건어물·향신료·포장 식품</span></h3><p class="lang-vi">Cà phê, hạt điều, gia vị và đặc sản khô — kiểm tra bao bì, hạn dùng và điều kiện mang theo khi di chuyển xa.</p><p class="lang-en">Coffee, cashews, spices and dried specialities — check packaging, use-by and transport rules for longer trips.</p><p class="lang-zh">咖啡、腰果、香料与干特产——长途携带时检查包装、保质期与携带规定。</p><p class="lang-ko">커피·캐슈너트·향신료·건특산품 — 멀리 갈 때 포장·유통기한·반입 규정을 확인하세요.</p></div></article>
          <article class="food-item"><b>03</b><div><h3><span class="lang-vi">Trái cây & nông sản</span><span class="lang-en">Fruit & produce</span><span class="lang-zh">水果与农产</span><span class="lang-ko">과일·농산물</span></h3><p class="lang-vi">Trái cây theo mùa và rau củ địa phương; hỏi giá theo đơn vị và cân nhắc nhiệt độ khi mang đi xa.</p><p class="lang-en">Seasonal fruit and local produce; ask how prices are measured and consider heat when carrying away.</p><p class="lang-zh">时令水果与当地蔬菜；询问计价单位，远途携带考虑温度。</p><p class="lang-ko">제철 과일과 현지 농산물; 단위 가격을 묻고 멀리 갈 때 온도를 고려하세요.</p></div></article>
          <article class="food-item"><b>04</b><div><h3><span class="lang-vi">Nước uống & đồ uống</span><span class="lang-en">Drinks</span><span class="lang-zh">饮品</span><span class="lang-ko">음료</span></h3><p class="lang-vi">Nước dừa, trà, cà phê và nước ép thường có tại gian ăn uống — tiện để nghỉ giữa buổi tham quan.</p><p class="lang-en">Coconut water, tea, coffee and juices are usually around the eating area — handy for a mid-visit break.</p><p class="lang-zh">椰子水、茶、咖啡与果汁通常在饮食区——方便中途休息。</p><p class="lang-ko">코코넛 워터·차·커피·주스는 식사 구역 주변에 있어 방문 중 쉬기에 좋습니다.</p></div></article>
        </div>
        <p class="intro-text lang-vi">Lưu ý vệ sinh: chọn quầy đông khách, quan sát chế biến và hỏi thành phần nếu bạn có dị ứng. Chúng tôi không xếp hạng hay giới thiệu cơ sở cụ thể.</p>
        <p class="intro-text lang-en">Hygiene note: prefer busy stalls, watch preparation and ask ingredients if allergic. We do not rank or endorse specific businesses.</p>
        <p class="intro-text lang-zh">卫生提示：优先人气摊位、观察制作过程，有过敏请询问成分。我们不排名也不推荐具体商家。</p>
        <p class="intro-text lang-ko">위생: 손님 많은 가게를 고르고 조리 과정을 지켜보며 알레르기 있으면 재료를 물어보세요. 특정 업체를 추천하지 않습니다.</p>
      </div>
    </section>
    <section class="faq" aria-labelledby="faq-title"><div class="section-shell"><div><p class="section-index">02 —</p><p class="eyebrow"><span class="lang-vi">Câu hỏi thường gặp</span><span class="lang-en">FAQ</span><span class="lang-zh">常见问题</span><span class="lang-ko">자주 묻는 질문</span></p></div><div><h2 id="faq-title" class="display section-title"><span class="lang-vi">Về ẩm thực chợ</span><span class="lang-en">On market food</span><span class="lang-zh">关于市场美食</span><span class="lang-ko">시장 음식</span></h2><div class="faq-list"><details><summary><span class="lang-vi">Chợ Cồn có nhiều món ăn không?</span><span class="lang-en">Does Chợ Cồn have a lot of food?</span><span class="lang-zh">昆市场有很多美食吗？</span><span class="lang-ko">꼰 시장에 음식이 많나요?</span></summary><div class="answer"><p class="lang-vi">Có các quầy ăn, khu thực phẩm tươi và gian gia vị bên trong chợ. Chúng tôi mô tả theo dạng trải nghiệm, không đề xuất quầy cụ thể.</p><p class="lang-en">The market includes food stalls, fresh-food and spice sections. This guide describes experience types rather than recommending specific stalls.</p><p class="lang-zh">市场内有餐饮摊位、生鲜与香料区。本指南按体验类型描述，不推荐具体摊位。</p><p class="lang-ko">시장 안에는 식당·식료품·향신료 구역이 있습니다. 이 가이드는 체험 유형만 안내하며 특정 가게를 추천하지 않습니다.</p></div></details><details><summary><span class="lang-vi">Giá món ăn ở chợ thế nào?</span><span class="lang-en">How much does market food cost?</span><span class="lang-zh">市场里食物大概多少钱？</span><span class="lang-ko">시장 음식 가격은 얼마인가요?</span></summary><div class="answer"><p class="lang-vi">Giá do từng quầy tự định và thường theo khẩu phần hoặc theo cân. Hỏi giá trước khi gọi món để thuận tiện cho cả hai bên.</p><p class="lang-en">Prices are set per stall, usually by portion or by weight. Ask before ordering so both sides are clear.</p><p class="lang-zh">价格由摊位自定，通常按份或按重量。点餐前问价，双方都清楚。</p><p class="lang-ko">가격은 가게마다 다르며 보통 1인분 또는 중량 단위입니다. 주문 전 가격을 물어보세요.</p></div></details><details><summary><span class="lang-vi">Có an toàn khi ăn ở chợ không?</span><span class="lang-en">Is it safe to eat at the market?</span><span class="lang-zh">在市场吃东西安全吗？</span><span class="lang-ko">시장에서 먹는 것은 안전한가요?</span></summary><div class="answer"><p class="lang-vi">Nên chọn quầy đông khách, quan sát chế biến và hỏi thành phần nếu bạn có dị ứng hoặc chế độ ăn riêng.</p><p class="lang-en">Prefer busy stalls, watch preparation and ask ingredients if you have allergies or dietary needs.</p><p class="lang-zh">优先人气摊位、观察制作过程，有过敏或特殊饮食请询问成分。</p><p class="lang-ko">손님 많은 가게를 고르고 조리 과정을 지켜보며 알레르기나 식이 제한이 있으면 재료를 물어보세요.</p></div></details><details><summary><span class="lang-vi">Có chỗ ngồi ăn tại chợ không?</span><span class="lang-en">Is there seating inside the market?</span><span class="lang-zh">市场内有座位用餐吗？</span><span class="lang-ko">시장 안에 좌석이 있나요?</span></summary><div class="answer"><p class="lang-vi">Nhiều quầy ăn chế biến tại chỗ có chỗ ngồi đơn giản; không gian có thể đông vào giờ cao điểm.</p><p class="lang-en">Many prepared-food stalls have simple seating; it can be busy at peak times.</p><p class="lang-zh">许多现做摊位有简易座位；高峰时段可能拥挤。</p><p class="lang-ko">많은 조리 가게에 간단한 좌석이 있으나 피크타임엔 붐빌 수 있습니다.</p></div></details><details><summary><span class="lang-vi">Món nào nên thử trước?</span><span class="lang-en">Which dish should I try first?</span><span class="lang-zh">先试哪种食物好？</span><span class="lang-ko">무엇을 먼저 시도할까요?</span></summary><div class="answer"><p class="lang-vi">Tuỳ sở thích, bạn có thể bắt đầu từ bún, bánh xèo, chè hoặc các món ăn vặt miền Trung. Chúng tôi chỉ gợi ý dạng món, không xếp hạng quầy.</p><p class="lang-en">By preference, you might start with bún, bánh xèo, chè or Central-Vietnam snacks. We suggest dish types, not ranked stalls.</p><p class="lang-zh">按喜好，可从米线、煎饼、甜品或中部小吃开始。我们只建议类型，不排摊位名次。</p><p class="lang-ko">취향에 따라 쌀국수·녹두전·단팥·중부 간식부터 시작하세요. 우리는 유형만 제안하며 순위는 매기지 않습니다.</p></div></details></div></div></div></section>

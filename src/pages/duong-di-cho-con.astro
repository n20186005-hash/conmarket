---
// Sub-page: how to reach Chợ Cồn, by origin (airport, Hàn Market, My Khe, Bà Nà) plus transit notes.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
export const prerender = true;
const pageUrl = Astro.site ? new URL("/duong-di-cho-con/", Astro.site).href : "https://conmarket.org/duong-di-cho-con/";
const homeUrl = Astro.site ? new URL("/", Astro.site).href : "https://conmarket.org/";
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Chợ Cồn (Con Market)", item: homeUrl },
  { "@type": "ListItem", position: 2, name: "Đường đi Chợ Cồn", item: pageUrl }
] };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: [
  { "@type": "Question", name: "Từ sân bay Đà Nẵng đi Chợ Cồn mất bao lâu?", acceptedAnswer: { "@type": "Answer", text: "Sân bay cách chợ khoảng 3 km; taxi hoặc xe công nghệ thường mất 10–15 phút tuỳ đường. / The airport is about 3 km away; taxi or ride-hailing usually takes 10–15 minutes by traffic." } },
  { "@type": "Question", name: "Có xe buýt đến Chợ Cồn không?", acceptedAnswer: { "@type": "Answer", text: "Mạng lưới buýt thành phố có tuyến qua trục Hùng Vương và khu Hải Châu. Tra cứu lộ trình hiện hành trước chuyến đi vì tuyến có thể điều chỉnh. / City buses run along Hùng Vương and Hải Châu. Check the current route map before travel, as lines can change." } },
  { "@type": "Question", name: "Đi bộ từ trung tâm mất bao lâu?", acceptedAnswer: { "@type": "Answer", text: "Từ nhiều khách sạn trung tâm, chợ cách 10–20 phút đi bộ hoặc đạp xe. Đường đông, hãy để ý xe máy khi sang đường. / From many downtown hotels the market is a 10–20 minute walk or cycle. Streets are busy — watch for motorbikes when crossing." } },
  { "@type": "Question", name: "Gửi xe máy ở đâu khi đi chợ?", acceptedAnswer: { "@type": "Answer", text: "Khu gửi xe phụ thuộc cổng, thời điểm và quy định tại chỗ. Hỏi nhân viên khu gửi xe và không dừng trên làn xe lưu thông. / Parking depends on the entrance, time and on-site rules. Ask at the parking area and avoid stopping in traffic lanes." } },
  { "@type": "Question", name: "Đi taxi từ sân bay hết bao nhiêu?", acceptedAnswer: { "@type": "Answer", text: "Giá theo đồng hồ hoặc ước lượng của ứng dụng; khoảng cách ngắn (3 km) nên chi phí thường vừa phải. Hãy xác nhận điểm trả khách an toàn, tránh chặn cổng chợ. / Fares follow the meter or app estimate; the short 3 km distance keeps cost modest. Confirm a safe drop-off that does not block a market entrance." } }
] };
---
<BaseLayout title="Đường đi Chợ Cồn Đà Nẵng — Từ sân bay, xe buýt, taxi" description="Cách đến Chợ Cồn (Con Market) Đà Nẵng: từ sân bay, xe buýt, taxi, xe công nghệ và đi bộ, kèm bản đồ và lưu ý gửi xe." canonicalPath="/duong-di-cho-con/">
  <header class="guide-hero"><div class="topbar"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="44" height="44" /><span class="brand-name">CHỢ CỒN</span></a><LanguageSwitch /></div><div class="section-shell"><p class="eyebrow">Bản đồ & giao thông</p><h1 class="display"><span class="lang-vi">Đường đi Chợ Cồn</span><span class="lang-en">How to reach Chợ Cồn</span></h1><p class="intro-text"><span class="lang-vi">Chợ nằm ở trung tâm quận Hải Châu, gần nhiều khách sạn nội thành. Dưới đây là định hướng theo từng điểm xuất phát — tuyến cụ thể có thể thay đổi theo thời gian.</span><span class="lang-en">The market sits in central Hải Châu, close to many downtown hotels. The notes below are by origin — actual routes can change over time.</span></p><a class="guide-back" href="/"><span class="lang-vi">← Trở về hướng dẫn chính</span><span class="lang-en">← Return to main guide</span></a></div></header>
  <main class="guide-body">
    <section class="section-shell" aria-labelledby="route-title">
      <div><p class="section-index">01 —</p><p class="eyebrow">Theo điểm xuất phát</p></div>
      <div>
        <h2 id="route-title" class="display section-title"><span class="lang-vi">Từng cách đi đến chợ</span><span class="lang-en">Reaching the market, option by option</span></h2>
        <div class="transport-grid">
          <article class="transport-card"><span class="card-number">01</span><h3><span class="lang-vi">Từ sân bay Đà Nẵng</span><span class="lang-en">From Da Nang Airport</span></h3><p class="lang-vi">Cách chợ khoảng 3 km. Taxi, xe công nghệ hoặc xe thuê là cách trực tiếp; cho địa chỉ “90 Hùng Vương, Hải Châu”. Thường 10–15 phút.</p><p class="lang-en">About 3 km away. Taxi, ride-hailing or a hired car are direct; give “90 Hùng Vương, Hải Châu”. Usually 10–15 minutes.</p></article>
          <article class="transport-card"><span class="card-number">02</span><h3><span class="lang-vi">Từ Chợ Hàn</span><span class="lang-en">From Hàn Market</span></h3><p class="lang-vi">Hai chợ đều ở trung tâm, cách nhau khoảng 1–2 km. Có thể đi bộ, xe buýt hoặc taxi tuỳ thời tiết và hành lý.</p><p class="lang-en">Both markets are central, about 1–2 km apart. Walk, bus or taxi depending on weather and luggage.</p></article>
          <article class="transport-card"><span class="card-number">03</span><h3><span class="lang-vi">Từ biển Mỹ Khê</span><span class="lang-en">From My Khe beach</span></h3><p class="lang-vi">Bãi biển cách chợ khoảng 3–4 km về phía tây. Taxi, xe công nghệ hoặc xe buýt dọc trục chính đều thuận tiện.</p><p class="lang-en">The beach is about 3–4 km west of the market. Taxi, ride-hailing or a bus along the main axis all work.</p></article>
          <article class="transport-card"><span class="card-number">04</span><h3><span class="lang-vi">Từ Bà Nà Hills</span><span class="lang-en">From Bà Nà Hills</span></h3><p class="lang-vi">Cách chợ khoảng 40 km (phía tây, trên núi). Nên đi xe ô tô thuê hoặc tour; không phù hợp đi bộ hay xe máy một ngày.</p><p class="lang-en">About 40 km west in the hills. Use a hired car or tour; not a walk or motorbike day-trip.</p></article>
          <article class="transport-card"><span class="card-number">05</span><h3><span class="lang-vi">Xe buýt & taxi</span><span class="lang-en">Bus & taxi</span></h3><p class="lang-vi">Buýt thành phố qua trục Hùng Vương; taxi/xe công nghệ cho điểm trả khách cụ thể. Hỏi giá trước nếu đi xa hơn trung tâm.</p><p class="lang-en">City buses run along Hùng Vương; taxi/ride-hailing for a specific drop-off. Agree fares in advance beyond the centre.</p></article>
          <article class="transport-card"><span class="card-number">06</span><h3><span class="lang-vi">Đi bộ, xe đạp & gửi xe</span><span class="lang-en">Walk, cycle & parking</span></h3><p class="lang-vi">Từ trung tâm đi bộ 10–20 phút. Gửi xe phụ thuộc cổng và quy định tại chỗ; hỏi nhân viên khu gửi xe.</p><p class="lang-en">A 10–20 minute walk from the centre. Parking depends on the entrance and on-site rules; ask staff.</p></article>
        </div>
        <a class="route-link" href="https://maps.app.goo.gl/MS8rWseJ7bPBQRrt8" target="_blank" rel="noopener noreferrer"><span class="lang-vi">Mở chỉ đường trong Google Maps</span><span class="lang-en">Open directions in Google Maps</span> ↗</a>
      </div>
    </section>
    <section class="faq" aria-labelledby="faq-title"><div class="section-shell"><div><p class="section-index">02 —</p><p class="eyebrow">Câu hỏi thường gặp</p></div><div><h2 id="faq-title" class="display section-title"><span class="lang-vi">Về đường đi</span><span class="lang-en">On getting there</span></h2><div class="faq-list"><details><summary><span class="lang-vi">Từ sân bay Đà Nẵng đi Chợ Cồn mất bao lâu?</span><span class="lang-en">How long from the airport to Chợ Cồn?</span></summary><div class="answer"><p class="lang-vi">Sân bay cách chợ khoảng 3 km; taxi hoặc xe công nghệ thường mất 10–15 phút tuỳ đường.</p><p class="lang-en">The airport is about 3 km away; taxi or ride-hailing usually takes 10–15 minutes by traffic.</p></div></details><details><summary><span class="lang-vi">Có xe buýt đến Chợ Cồn không?</span><span class="lang-en">Is there a bus to Chợ Cồn?</span></summary><div class="answer"><p class="lang-vi">Mạng lưới buýt thành phố có tuyến qua trục Hùng Vương và khu Hải Châu. Tra cứu lộ trình hiện hành trước chuyến đi vì tuyến có thể điều chỉnh.</p><p class="lang-en">City buses run along Hùng Vương and Hải Châu. Check the current route map before travel, as lines can change.</p></div></details><details><summary><span class="lang-vi">Đi bộ từ trung tâm mất bao lâu?</span><span class="lang-en">How long on foot from the centre?</span></summary><div class="answer"><p class="lang-vi">Từ nhiều khách sạn trung tâm, chợ cách 10–20 phút đi bộ hoặc đạp xe. Đường đông, hãy để ý xe máy khi sang đường.</p><p class="lang-en">From many downtown hotels the market is a 10–20 minute walk or cycle. Streets are busy — watch for motorbikes when crossing.</p></div></details><details><summary><span class="lang-vi">Gửi xe máy ở đâu khi đi chợ?</span><span class="lang-en">Where do I park at the market?</span></summary><div class="answer"><p class="lang-vi">Khu gửi xe phụ thuộc cổng, thời điểm và quy định tại chỗ. Hỏi nhân viên khu gửi xe và không dừng trên làn xe lưu thông.</p><p class="lang-en">Parking depends on the entrance, time and on-site rules. Ask at the parking area and avoid stopping in traffic lanes.</p></div></details><details><summary><span class="lang-vi">Đi taxi từ sân bay hết bao nhiêu?</span><span class="lang-en">How much is a taxi from the airport?</span></summary><div class="answer"><p class="lang-vi">Giá theo đồng hồ hoặc ước lượng của ứng dụng; khoảng cách ngắn (3 km) nên chi phí thường vừa phải. Hãy xác nhận điểm trả khách an toàn, tránh chặn cổng chợ.</p><p class="lang-en">Fares follow the meter or app estimate; the short 3 km distance keeps cost modest. Confirm a safe drop-off that does not block a market entrance.</p></div></details></div></div></div></section>
    <section class="nearby" aria-labelledby="more-title"><div class="section-shell"><div><p class="section-index">03 —</p><p class="eyebrow" style="color:#F3B23C">Đọc sâu hơn</p></div><div><h2 id="more-title" class="display section-title"><span class="lang-vi">Các hướng dẫn chi tiết khác</span><span class="lang-en">More detailed guides</span></h2></div></div><div class="nearby-grid"><article class="nearby-item"><small><span class="lang-vi">Giờ mở cửa</span><span class="lang-en">Hours</span></small><h3><span class="lang-vi">Giờ mở cửa Chợ Cồn</span><span class="lang-en">Chợ Cồn opening hours</span></h3><p class="lang-vi">Khung giờ thường thấy, thời điểm nên đi và thanh toán.</p><p class="lang-en">Common hours, best time to visit and payment.</p><a href="/gio-mo-cua-cho-con/"><span class="lang-vi">Xem hướng dẫn giờ mở cửa</span><span class="lang-en">See hours guide</span> ↗</a></article><article class="nearby-item"><small><span class="lang-vi">Món ăn</span><span class="lang-en">Food</span></small><h3><span class="lang-vi">Ăn gì ở Chợ Cồn</span><span class="lang-en">What to eat at Chợ Cồn</span></h3><p class="lang-vi">Các loại hình ẩm thực theo gian hàng, trung lập và không đề xuất quầy cụ thể.</p><p class="lang-en">Food types by stall, neutral and naming no specific stall.</p><a href="/mon-an-cho-con/"><span class="lang-vi">Xem hướng dẫn ăn uống</span><span class="lang-en">See the food guide</span> ↗</a></article><article class="nearby-item"><small><span class="lang-vi">Trang chính</span><span class="lang-en">Main guide</span></small><h3><span class="lang-vi">Hướng dẫn Chợ Cồn</span><span class="lang-en">Chợ Cồn guide</span></h3><p class="lang-vi">Tổng quan lịch sử, thời tiết, tiện ích và trách nhiệm tham quan.</p><p class="lang-en">Overview of history, weather, facilities and visiting responsibly.</p><a href="/"><span class="lang-vi">Về hướng dẫn chính</span><span class="lang-en">Back to main guide</span> ↗</a></article></div></section>
  </main><SiteFooter /><script is:inline type="application/ld+json" set:html={JSON.stringify([breadcrumb, faqSchema])}></script>
</BaseLayout>

---
// Sub-page: how to reach Chợ Cồn, by origin (airport, Hàn Market, My Khe, Bà Nà) plus transit notes.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
export const prerender = true;
const pageUrl = Astro.site ? new URL("/duong-di-cho-con/", Astro.site).href : "https://conmarket.org/duong-di-cho-con/";
const homeUrl = Astro.site ? new URL("/", Astro.site).href : "https://conmarket.org/";
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Chợ Cồn (Con Market)", item: homeUrl },
  { "@type": "ListItem", position: 2, name: "Đường đi Chợ Cồn", item: pageUrl }
] };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: [
  { "@type": "Question", name: "Từ sân bay Đà Nẵng đi Chợ Cồn mất bao lâu?", acceptedAnswer: { "@type": "Answer", text: "Sân bay cách chợ khoảng 3 km; taxi hoặc xe công nghệ thường mất 10–15 phút tuỳ đường. / The airport is about 3 km away; taxi or ride-hailing usually takes 10–15 minutes by traffic. / 机场距市场约 3 公里；出租车或网约车通常视路况 10–15 分钟。 / 공항은 약 3km 거리로 택시나 카풀은 도로 상황에 따라 보통 10~15분." } },
  { "@type": "Question", name: "Có xe buýt đến Chợ Cồn không?", acceptedAnswer: { "@type": "Answer", text: "Mạng lưới buýt thành phố có các tuyến qua trục Hùng Vương và khu Hải Châu. Tra cứu lộ trình hiện hành trước chuyến đi vì tuyến có thể điều chỉnh. / City buses run along Hùng Vương and Hải Châu. Check the current route map before travel, as lines can change. / 市内公交有线路经雄王街与海洲区。出行前查最新线路，线路可能调整。 / 시내 버스는 훙ヴュ오ン과 하이쩌우를 지납니다. 노선이 바뀔 수 있으니 이동 전 현재 노선을 확인하세요." } },
  { "@type": "Question", name: "Đi bộ từ trung tâm mất bao lâu?", acceptedAnswer: { "@type": "Answer", text: "Từ nhiều khách sạn trung tâm, chợ cách 10–20 phút đi bộ hoặc đạp xe. Đường đông, hãy để ý xe máy khi sang đường. / From many downtown hotels the market is a 10–20 minute walk or cycle. Streets are busy — watch for motorbikes when crossing. / 从许多市中心酒店步行或骑行约 10–20 分钟。街道繁忙，过马路留意摩托车。 / 시내 호텔에서 도보·자전거로 약 10~20분입니다. 길이 붐비니 건널목에서 오토바이를 조심하세요." } },
  { "@type": "Question", name: "Gửi xe máy ở đâu khi đi chợ?", acceptedAnswer: { "@type": "Answer", text: "Khu gửi xe phụ thuộc cổng, thời điểm và quy định tại chỗ. Hỏi nhân viên khu gửi xe và không dừng trên làn xe lưu thông. / Parking depends on the entrance, time and on-site rules. Ask at the parking area and avoid stopping in traffic lanes. / 停车取决于入口、时段与现场规定。咨询停车处，勿停在车道。 / 주차는 출입구·시간·현장 규정에 따릅니다. 주차 안내원에게 묻고 차로에 정차하지 마세요." } },
  { "@type": "Question", name: "Đi taxi từ sân bay hết bao nhiêu?", acceptedAnswer: { "@type": "Answer", text: "Giá theo đồng hồ hoặc ước lượng của ứng dụng; khoảng cách ngắn (3 km) nên chi phí thường vừa phải. Hãy xác nhận điểm trả khách an toàn, tránh chặn cổng chợ. / Fares follow the meter or app estimate; the short 3 km distance keeps cost modest. Confirm a safe drop-off that does not block a market entrance. / 按表或 app 估算；距离短（3 公里）费用通常不高。确认安全的下客点，勿堵入口。 / 요금은 미터기나 앱 기준이며 3km 거리라 비용은 적당합니다. 시장 입구를 막지 않는 안전한 하차 지점을 확인하세요." } }
] };
---
<BaseLayout title="Đường đi Chợ Cồn Đà Nẵng — Từ sân bay, xe buýt, taxi" description="Cách đến Chợ Cồn (Con Market) Đà Nẵng: từ sân bay, xe buýt, taxi, xe công nghệ và đi bộ, kèm bản đồ và lưu ý gửi xe." titleEn="How to reach Chợ Cồn Đà Nẵng — Airport, bus, taxi" descriptionEn="Reaching Chợ Cồn (Con Market) in Đà Nẵng: from the airport, bus, taxi, ride-hailing and on foot, with a map and parking notes." titleZh="如何前往岘港昆市场 — 机场、公交、出租车" descriptionZh="岘港昆市场（Con Market）的交通指南：从机场、公交、出租车、步行按出发地指引（越/英/中/韩）。" titleKo="다낭 꼰 시장 오는 법 — 공항·버스·택시" descriptionKo="다낭 꼰 시장(Con Market) 교통 가이드: 공항·버스·택시·도보 출발지별 안내(베트남어·영어·중국어·한국어).">
  <header class="guide-hero"><div class="topbar"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="44" height="44" /><span class="brand-name">CHỢ CỒN</span></a><LanguageSwitch /></div><div class="section-shell"><p class="eyebrow"><span class="lang-vi">Bản đồ & giao thông</span><span class="lang-en">Map & transport</span><span class="lang-zh">地图与交通</span><span class="lang-ko">지도와 교통</span></p><h1 class="display"><span class="lang-vi">Đường đi Chợ Cồn</span><span class="lang-en">How to reach Chợ Cồn</span><span class="lang-zh">如何前往昆市场</span><span class="lang-ko">꼰 시장 오는 법</span></h1><p class="intro-text"><span class="lang-vi">Chợ nằm ở trung tâm quận Hải Châu, gần nhiều khách sạn nội thành. Dưới đây là định hướng theo từng điểm xuất phát — tuyến cụ thể có thể thay đổi theo thời gian.</span><span class="lang-en">The market sits in central Hải Châu, close to many downtown hotels. The notes below are by origin — actual routes can change over time.</span><span class="lang-zh">市场位于海洲郡中心，靠近许多市区酒店。以下按出发地指引——具体线路可能随时间变化。</span><span class="lang-ko">시장은 하이쩌우군 중심가에 있어 시내 호텔과 가깝습니다. 아래는 출발지별 안내로 실제 노선은 바뀔 수 있습니다.</span></p><a class="guide-back" href="/"><span class="lang-vi">← Trở về hướng dẫn chính</span><span class="lang-en">← Return to main guide</span><span class="lang-zh">← 返回主指南</span><span class="lang-ko">← 메인 가이드로</span></a></div></header>
  <main class="guide-body">
    <section class="section-shell" aria-labelledby="route-title">
      <div><p class="section-index">01 —</p><p class="eyebrow"><span class="lang-vi">Theo điểm xuất phát</span><span class="lang-en">By origin</span><span class="lang-zh">按出发地</span><span class="lang-ko">출발지별</span></p></div>
      <div>
        <h2 id="route-title" class="display section-title"><span class="lang-vi">Từng cách đi đến chợ</span><span class="lang-en">Reaching the market, option by option</span><span class="lang-zh">各方式前往市场</span><span class="lang-ko">방법별 시장 가기</span></h2>
        <div class="transport-grid">
          <article class="transport-card"><span class="card-number">01</span><h3><span class="lang-vi">Từ sân bay Đà Nẵng</span><span class="lang-en">From Da Nang Airport</span><span class="lang-zh">从岘港机场</span><span class="lang-ko">다낭 공항에서</span></h3><p class="lang-vi">Cách chợ khoảng 3 km. Taxi, xe công nghệ hoặc xe thuê là cách trực tiếp; cho địa chỉ “90 Hùng Vương, Hải Châu”. Thường 10–15 phút.</p><p class="lang-en">About 3 km away. Taxi, ride-hailing or a hired car are direct; give “90 Hùng Vương, Hải Châu”. Usually 10–15 minutes.</p><p class="lang-zh">距市场约 3 公里。出租车、网约车或租车直达；目的地报“90 Hùng Vương, Hải Châu”。通常 10–15 分钟。</p><p class="lang-ko">약 3km 거리. 택시·카풀·렌터카가 직행이며 목적지를 “90 Hùng Vương, Hải Châu”라 하세요. 보통 10~15분.</p></article>
          <article class="transport-card"><span class="card-number">02</span><h3><span class="lang-vi">Từ Chợ Hàn</span><span class="lang-en">From Hàn Market</span><span class="lang-zh">从韩市场</span><span class="lang-ko">한 시장에서</span></h3><p class="lang-vi">Hai chợ đều ở trung tâm, cách nhau khoảng 1–2 km. Có thể đi bộ, xe buýt hoặc taxi tuỳ thời tiết và hành lý.</p><p class="lang-en">Both markets are central, about 1–2 km apart. Walk, bus or taxi depending on weather and luggage.</p><p class="lang-zh">两市场都在市中心，相距约 1–2 公里。可按天气与行李步行、乘公交或出租车。</p><p class="lang-ko">두 시장 모두 중심가에 있으며 1~2km 거리입니다. 날씨와 짐에 따라 도보·버스·택시로 이동하세요.</p></article>
          <article class="transport-card"><span class="card-number">03</span><h3><span class="lang-vi">Từ biển Mỹ Khê</span><span class="lang-en">From My Khe beach</span><span class="lang-zh">从美溪海滩</span><span class="lang-ko">미케 해변에서</span></h3><p class="lang-vi">Bãi biển cách chợ khoảng 3–4 km về phía tây. Taxi, xe công nghệ hoặc xe buýt dọc trục chính đều thuận tiện.</p><p class="lang-en">The beach is about 3–4 km west of the market. Taxi, ride-hailing or a bus along the main axis all work.</p><p class="lang-zh">海滩距市场约 3–4 公里（西侧）。出租车、网约车或沿主干道的公交都方便。</p><p class="lang-ko">해변은 시장에서 서쪽으로 약 3~4km입니다. 택시·카풀·주요 도로 버스 모두 편리합니다.</p></article>
          <article class="transport-card"><span class="card-number">04</span><h3><span class="lang-vi">Từ Bà Nà Hills</span><span class="lang-en">From Bà Nà Hills</span><span class="lang-zh">从巴拿山</span><span class="lang-ko">바나힐에서</span></h3><p class="lang-vi">Cách chợ khoảng 40 km (phía tây, trên núi). Nên đi xe ô tô thuê hoặc tour; không phù hợp đi bộ hay xe máy một ngày.</p><p class="lang-en">About 40 km west in the hills. Use a hired car or tour; not a walk or motorbike day-trip.</p><p class="lang-zh">距市场约 40 公里（西侧山区）。建议租车或跟团；不适合步行或摩托车一日往返。</p><p class="lang-ko">서쪽 산속 약 40km. 렌터카나 투어를 이용하세요. 도보나 오토바이 당일치기는 적합하지 않습니다.</p></article>
          <article class="transport-card"><span class="card-number">05</span><h3><span class="lang-vi">Xe buýt & taxi</span><span class="lang-en">Bus & taxi</span><span class="lang-zh">公交与出租</span><span class="lang-ko">버스와 택시</span></h3><p class="lang-vi">Buýt thành phố qua trục Hùng Vương; taxi/xe công nghệ cho điểm trả khách cụ thể. Hỏi giá trước nếu đi xa hơn trung tâm.</p><p class="lang-en">City buses run along Hùng Vương; taxi/ride-hailing for a specific drop-off. Agree fares in advance beyond the centre.</p><p class="lang-zh">市内公交经雄王街；出租车/网约车可指定下客点。超出市中心请先谈价。</p><p class="lang-ko">시내 버스는 훙ヴュ오ン을 지납니다. 택시·카풀은 하차 지점 지정. 도심 밖은 미리 요금 합의.</p></article>
          <article class="transport-card"><span class="card-number">06</span><h3><span class="lang-vi">Đi bộ, xe đạp & gửi xe</span><span class="lang-en">Walk, cycle & parking</span><span class="lang-zh">步行、骑行与停车</span><span class="lang-ko">도보·자전거·주차</span></h3><p class="lang-vi">Từ trung tâm đi bộ 10–20 phút. Gửi xe phụ thuộc cổng và quy định tại chỗ; hỏi nhân viên khu gửi xe.</p><p class="lang-en">A 10–20 minute walk from the centre. Parking depends on the entrance and on-site rules; ask staff.</p><p class="lang-zh">从市中心步行约 10–20 分钟。停车取决于入口与现场规定；咨询停车处人员。</p><p class="lang-ko">중심가에서 도보 10~20분. 주차는 출입구·현장 규정에 따르며 주차 안내원에게 문의하세요.</p></article>
        </div>
        <a class="route-link" href="https://maps.app.goo.gl/MS8rWseJ7bPBQRrt8" target="_blank" rel="noopener noreferrer"><span class="lang-vi">Mở chỉ đường trong Google Maps</span><span class="lang-en">Open directions in Google Maps</span><span class="lang-zh">在 Google Maps 中打开导航</span><span class="lang-ko">Google Maps에서 길찾기</span> ↗</a>
      </div>
    </section>
    <section class="faq" aria-labelledby="faq-title"><div class="section-shell"><div><p class="section-index">02 —</p><p class="eyebrow"><span class="lang-vi">Câu hỏi thường gặp</span><span class="lang-en">FAQ</span><span class="lang-zh">常见问题</span><span class="lang-ko">자주 묻는 질문</span></p></div><div><h2 id="faq-title" class="display section-title"><span class="lang-vi">Về đường đi</span><span class="lang-en">On getting there</span><span class="lang-zh">关于前往方式</span><span class="lang-ko">오는 법</span></h2><div class="faq-list"><details><summary><span class="lang-vi">Từ sân bay Đà Nẵng đi Chợ Cồn mất bao lâu?</span><span class="lang-en">How long from the airport to Chợ Cồn?</span><span class="lang-zh">从岘港机场到昆市场要多久？</span><span class="lang-ko">다낭 공항에서 꼰 시장까지 얼마나 걸리나요?</span></summary><div class="answer"><p class="lang-vi">Sân bay cách chợ khoảng 3 km; taxi hoặc xe công nghệ thường mất 10–15 phút tuỳ đường.</p><p class="lang-en">The airport is about 3 km away; taxi or ride-hailing usually takes 10–15 minutes by traffic.</p><p class="lang-zh">机场距市场约 3 公里；出租车或网约车通常视路况 10–15 分钟。</p><p class="lang-ko">공항은 약 3km 거리로 택시나 카풀은 도로 상황에 따라 보통 10~15분.</p></div></details><details><summary><span class="lang-vi">Có xe buýt đến Chợ Cồn không?</span><span class="lang-en">Is there a bus to Chợ Cồn?</span><span class="lang-zh">有到昆市场的公交吗？</span><span class="lang-ko">꼰 시장 가는 버스가 있나요?</span></summary><div class="answer"><p class="lang-vi">Mạng lưới buýt thành phố có các tuyến qua trục Hùng Vương và khu Hải Châu. Tra cứu lộ trình hiện hành trước chuyến đi vì tuyến có thể điều chỉnh.</p><p class="lang-en">City buses run along Hùng Vương and Hải Châu. Check the current route map before travel, as lines can change.</p><p class="lang-zh">市内公交有线路经雄王街与海洲区。出行前查最新线路，线路可能调整。</p><p class="lang-ko">시내 버스는 훙ヴュ오ン과 하이쩌우를 지납니다. 노선이 바뀔 수 있으니 이동 전 현재 노선을 확인하세요.</p></div></details><details><summary><span class="lang-vi">Đi bộ từ trung tâm mất bao lâu?</span><span class="lang-en">How long on foot from the centre?</span><span class="lang-zh">从市中心步行要多久？</span><span class="lang-ko">중심가에서 도보는 얼마나 걸리나요?</span></summary><div class="answer"><p class="lang-vi">Từ nhiều khách sạn trung tâm, chợ cách 10–20 phút đi bộ hoặc đạp xe. Đường đông, hãy để ý xe máy khi sang đường.</p><p class="lang-en">From many downtown hotels the market is a 10–20 minute walk or cycle. Streets are busy — watch for motorbikes when crossing.</p><p class="lang-zh">从许多市中心酒店步行或骑行约 10–20 分钟。街道繁忙，过马路留意摩托车。</p><p class="lang-ko">시내 호텔에서 도보·자전거로 약 10~20분입니다. 길이 붐비니 건널목에서 오토바이를 조심하세요.</p></div></details><details><summary><span class="lang-vi">Gửi xe máy ở đâu khi đi chợ?</span><span class="lang-en">Where do I park at the market?</span><span class="lang-zh">去市场把车停在哪里？</span><span class="lang-ko">시장에서는 어디에 주차하나요?</span></summary><div class="answer"><p class="lang-vi">Khu gửi xe phụ thuộc cổng, thời điểm và quy định tại chỗ. Hỏi nhân viên khu gửi xe và không dừng trên làn xe lưu thông.</p><p class="lang-en">Parking depends on the entrance, time and on-site rules. Ask at the parking area and avoid stopping in traffic lanes.</p><p class="lang-zh">停车取决于入口、时段与现场规定。咨询停车处，勿停在车道。</p><p class="lang-ko">주차는 출입구·시간·현장 규정에 따릅니다. 주차 안내원에게 묻고 차로에 정차하지 마세요.</p></div></details><details><summary><span class="lang-vi">Đi taxi từ sân bay hết bao nhiêu?</span><span class="lang-en">How much is a taxi from the airport?</span><span class="lang-zh">从机场打车多少钱？</span><span class="lang-ko">공항 택시 요금은 얼마인가요?</span></summary><div class="answer"><p class="lang-vi">Giá theo đồng hồ hoặc ước lượng của ứng dụng; khoảng cách ngắn (3 km) nên chi phí thường vừa phải. Hãy xác nhận điểm trả khách an toàn, tránh chặn cổng chợ.</p><p class="lang-en">Fares follow the meter or app estimate; the short 3 km distance keeps cost modest. Confirm a safe drop-off that does not block a market entrance.</p><p class="lang-zh">按表或 app 估算；距离短（3 公里）费用通常不高。确认安全的下客点，勿堵入口。</p><p class="lang-ko">요금은 미터기나 앱 기준이며 3km 거리라 비용은 적당합니다. 시장 입구를 막지 않는 안전한 하차 지점을 확인하세요.</p></div></details></div></div></div></section>

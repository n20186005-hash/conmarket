---
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TransportGuide from "../components/TransportGuide.astro";
import SourceNote from "../components/SourceNote.astro";
---
<BaseLayout title="Đường đi Chợ Cồn: địa chỉ và bản đồ | Đà Nẵng" description="Ghim bản đồ Chợ Cồn, địa chỉ khác nhau giữa nguồn và lưu ý đi lại." titleEn="Con Market directions: address and map | Da Nang" descriptionEn="Find Con Market with its map pin, address-source differences and practical arrival advice." titleZh="昆市场交通：地址与地图 | 岘港" descriptionZh="查看昆市场地图定位、不同来源地址及抵达注意事项。" titleKo="꼰 시장 길찾기: 주소와 지도 | 다낭" descriptionKo="꼰 시장 지도 핀, 출처별 주소 차이와 도착 전 확인 사항을 안내합니다."><main><header class="guide-hero"><div class="topbar"><a class="brand" href="/">CHỢ CỒN</a><LanguageSwitch /></div><div class="section-shell"><h1 class="display"><span class="lang-vi">Đường đi Chợ Cồn</span><span class="lang-en">Directions to Con Market</span><span class="lang-zh">昆市场交通</span><span class="lang-ko">꼰 시장 길찾기</span></h1><a href="/">Chợ Cồn · Guide</a></div></header><TransportGuide /><SourceNote /></main><SiteFooter /></BaseLayout>

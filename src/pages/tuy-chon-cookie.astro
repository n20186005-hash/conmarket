---
// Style reminder: cookie choices should be direct and calm, styled as practical field notes in paper and indigo—not as a dark-pattern consent wall.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<BaseLayout title="Tùy chọn cookie | Chợ Cồn" description="Quản lý tùy chọn cookie của Hướng dẫn Chợ Cồn độc lập."><main class="legal-page"><header class="legal-hero"><div class="topbar"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="44" height="44" /><span class="brand-name">CHỢ CỒN</span></a><LanguageSwitch /></div><div class="legal-hero-inner"><p class="eyebrow" style="color:#F3B23C">Thông tin trang</p><h1 class="display"><span class="lang-vi">Tùy chọn cookie</span><span class="lang-en">Cookie settings</span></h1><p class="lang-vi">Cập nhật: 08/2026</p><p class="lang-en">Updated: August 2026</p></div></header><article class="legal-content"><a class="legal-back" href="/">← <span class="lang-vi">Trở về hướng dẫn</span><span class="lang-en">Return to guide</span></a><p class="lang-vi">Bạn có thể quản lý các lựa chọn bên dưới. Cookie cần thiết luôn hoạt động để trang vận hành cơ bản.</p><p class="lang-en">You can manage your choices below. Essential cookies remain active for basic site operation.</p><div class="consent-grid"><div class="consent-option"><div><h3><span class="lang-vi">Cookie cần thiết</span><span class="lang-en">Essential cookies</span></h3><p class="lang-vi">Cần cho các chức năng cơ bản của trang và không thể tắt.</p><p class="lang-en">Required for basic site functions and cannot be disabled.</p></div><input class="toggle" type="checkbox" checked disabled aria-label="Essential cookies enabled" /></div><div class="consent-option"><div><h3><span class="lang-vi">Cookie phân tích</span><span class="lang-en">Analytics cookies</span></h3><p class="lang-vi">Giúp hiểu cách người đọc dùng trang thông qua dữ liệu tổng hợp. Nếu bật, Google Analytics sẽ được tải khi bạn mở lại trang.</p><p class="lang-en">Help us understand how readers use the site through aggregate data. If enabled, Google Analytics loads when you reopen the site.</p></div><input id="analytics" class="toggle" type="checkbox" aria-label="Analytics cookies" /></div><div class="consent-option"><div><h3><span class="lang-vi">Cookie tùy chọn</span><span class="lang-en">Preference cookies</span></h3><p class="lang-vi">Lưu lựa chọn ngôn ngữ của bạn trên thiết bị này.</p><p class="lang-en">Remember your language choice on this device.</p></div><input id="preferences" class="toggle" type="checkbox" checked aria-label="Preference cookies" /></div><div class="consent-option"><div><h3><span class="lang-vi">Cookie tiếp thị</span><span class="lang-en">Marketing cookies</span></h3><p class="lang-vi">Trang này không sử dụng cookie tiếp thị hoặc quảng cáo cá nhân hóa.</p><p class="lang-en">This site does not use marketing cookies or personalised advertising.</p></div><input class="toggle" type="checkbox" disabled aria-label="Marketing cookies disabled" /></div></div><div class="consent-actions"><button class="nav-chip" id="save-preferences" type="button"><span class="lang-vi">Lưu tùy chọn</span><span class="lang-en">Save preferences</span></button><button class="nav-chip secondary" id="reject-all" type="button"><span class="lang-vi">Từ chối tất cả tùy chọn</span><span class="lang-en">Reject all optional cookies</span></button></div></article></main><SiteFooter /><script is:inline>(()=>{const key="con-market-cookie-preferences",analytics=document.querySelector("#analytics"),preferences=document.querySelector("#preferences");try{const current=JSON.parse(localStorage.getItem(key)||"{}");analytics.checked=Boolean(current.analytics);preferences.checked=current.preferences!==false}catch{}document.querySelector("#save-preferences").addEventListener("click",()=>{localStorage.setItem(key,JSON.stringify({analytics:analytics.checked,preferences:preferences.checked}));window.location.assign("/")});document.querySelector("#reject-all").addEventListener("click",()=>{localStorage.setItem(key,JSON.stringify({analytics:false,preferences:false}));localStorage.removeItem("con-market-language");window.location.assign("/")})})();</script></BaseLayout>

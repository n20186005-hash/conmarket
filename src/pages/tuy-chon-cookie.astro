---
// Style reminder: cookie choices should be direct and calm, styled as practical field notes in paper and indigo—not as a dark-pattern consent wall.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
export const prerender = true;
---
<BaseLayout title="Tùy chọn cookie | Chợ Cồn" description="Quản lý tùy chọn cookie của Hướng dẫn Chợ Cồn độc lập." titleEn="Cookie settings | Chợ Cồn" descriptionEn="Manage cookie choices for the independent Chợ Cồn Guide." titleZh="Cookie 设置 | 昆市场" descriptionZh="管理独立昆市场指南的 Cookie 选项。" titleKo="쿠키 설정 | 꼰 시장" descriptionKo="독립 꼰 시장 가이드의 쿠키 선택 관리."><main class="legal-page"><header class="legal-hero"><div class="topbar"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="44" height="44" /><span class="brand-name">CHỢ CỒN</span></a><LanguageSwitch /></div><div class="legal-hero-inner"><p class="eyebrow" style="color:#F3B23C"><span class="lang-vi">Thông tin trang</span><span class="lang-en">Site information</span><span class="lang-zh">网站信息</span><span class="lang-ko">사이트 정보</span></p><h1 class="display"><span class="lang-vi">Tùy chọn cookie</span><span class="lang-en">Cookie settings</span><span class="lang-zh">Cookie 设置</span><span class="lang-ko">쿠키 설정</span></h1><p class="lang-vi">Cập nhật: 08/2026</p><p class="lang-en">Updated: August 2026</p><p class="lang-zh">更新：2026年8月</p><p class="lang-ko">업데이트: 2026년 8월</p></div></header><article class="legal-content"><a class="legal-back" href="/">← <span class="lang-vi">Trở về hướng dẫn</span><span class="lang-en">Return to guide</span><span class="lang-zh">返回指南</span><span class="lang-ko">가이드로</span></a><p class="lang-vi">Bạn có thể quản lý các lựa chọn bên dưới. Cookie cần thiết luôn hoạt động để trang vận hành cơ bản.</p><p class="lang-en">You can manage your choices below. Essential cookies remain active for basic site operation.</p><p class="lang-zh">你可以在下方管理选项。必要 Cookie 始终启用，以维持网站基本运行。</p><p class="lang-ko">아래에서 선택을 관리할 수 있습니다. 필수 쿠키는 기본 운영을 위해 항상 활성화됩니다.</p><div class="consent-grid"><div class="consent-option"><div><h3><span class="lang-vi">Cookie cần thiết</span><span class="lang-en">Essential cookies</span><span class="lang-zh">必要 Cookie</span><span class="lang-ko">필수 쿠키</span></h3><p class="lang-vi">Cần cho các chức năng cơ bản của trang và không thể tắt.</p><p class="lang-en">Required for basic site functions and cannot be disabled.</p><p class="lang-zh">网站基本功能所需，无法关闭。</p><p class="lang-ko">사이트 기본 기능에 필요하며 비활성화할 수 없습니다.</p></div><input class="toggle" type="checkbox" checked disabled aria-label="Essential cookies enabled" /></div><div class="consent-option"><div><h3><span class="lang-vi">Cookie phân tích</span><span class="lang-en">Analytics cookies</span><span class="lang-zh">分析 Cookie</span><span class="lang-ko">분석 쿠키</span></h3><p class="lang-vi">Giúp hiểu cách người đọc dùng trang thông qua dữ liệu tổng hợp. Nếu bật, Google Analytics sẽ được tải khi bạn mở lại trang.</p><p class="lang-en">Help us understand how readers use the site through aggregate data. If enabled, Google Analytics loads when you reopen the site.</p><p class="lang-zh">通过汇总数据了解读者如何使用网站。开启后，重新打开网站时会加载 Google Analytics。</p><p class="lang-ko">집계 데이터로 독자가 사이트를如何利用하는지 파악합니다. 켜면 사이트를 다시 열 때 Google Analytics가 로드됩니다.</p></div><input id="analytics" class="toggle" type="checkbox" aria-label="Analytics cookies" /></div><div class="consent-option"><div><h3><span class="lang-vi">Cookie tùy chọn</span><span class="lang-en">Preference cookies</span><span class="lang-zh">偏好 Cookie</span><span class="lang-ko">환경설정 쿠키</span></h3><p class="lang-vi">Lưu lựa chọn ngôn ngữ của bạn trên thiết bị này.</p><p class="lang-en">Remember your language choice on this device.</p><p class="lang-zh">在本设备记住你的语言选择。</p><p class="lang-ko">이 기기에서 언어 선택을 기억합니다.</p></div><input id="preferences" class="toggle" type="checkbox" checked aria-label="Preference cookies" /></div><div class="consent-option"><div><h3><span class="lang-vi">Cookie tiếp thị</span><span class="lang-en">Marketing cookies</span><span class="lang-zh">营销 Cookie</span><span class="lang-ko">마케팅 쿠키</span></h3><p class="lang-vi">Trang này không sử dụng cookie tiếp thị hoặc quảng cáo cá nhân hóa.</p><p class="lang-en">This site does not use marketing cookies or personalised advertising.</p><p class="lang-zh">本站不使用营销 Cookie 或个性化广告。</p><p class="lang-ko">이 사이트는 마케팅 쿠키나 맞춤 광고를 사용하지 않습니다.</p></div><input class="toggle" type="checkbox" disabled aria-label="Marketing cookies disabled" /></div></div><div class="consent-actions"><button class="nav-chip" id="save-preferences" type="button"><span class="lang-vi">Lưu tùy chọn</span><span class="lang-en">Save preferences</span><span class="lang-zh">保存设置</span><span class="lang-ko">환경설정 저장</span></button><button class="nav-chip secondary" id="reject-all" type="button"><span class="lang-vi">Từ chối tất cả tùy chọn</span><span class="lang-en">Reject all optional cookies</span><span class="lang-zh">拒绝所有可选 Cookie</span><span class="lang-ko">모든 선택 쿠키 거부</span></button></div></article></main><SiteFooter /><script is:inline>(()=>{const key="con-market-cookie-preferences",analytics=document.querySelector("#analytics"),preferences=document.querySelector("#preferences");try{const current=JSON.parse(localStorage.getItem(key)||"{}");analytics.checked=Boolean(current.analytics);preferences.checked=current.preferences!==false}catch{}document.querySelector("#save-preferences").addEventListener("click",()=>{localStorage.setItem(key,JSON.stringify({analytics:analytics.checked,preferences:preferences.checked}));window.location.assign("/")});document.querySelector("#reject-all").addEventListener("click",()=>{localStorage.setItem(key,JSON.stringify({analytics:false,preferences:false}));localStorage.removeItem("con-market-language");window.location.assign("/")})})();</script></BaseLayout>

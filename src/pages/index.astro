---
// Style reminder: the home page is a walk through a traditional Vietnamese market—real photographs make the place tangible, while indigo print motifs organize facts and movement.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WeatherSection from "../components/WeatherSection.astro";
import HistorySection from "../components/HistorySection.astro";
import TransportGuide from "../components/TransportGuide.astro";
import SeasonalStrategy from "../components/SeasonalStrategy.astro";
import Itineraries from "../components/Itineraries.astro";
import VisitorResponsibility from "../components/VisitorResponsibility.astro";
export const prerender = true;
const pageUrl = Astro.site ? new URL("/", Astro.site).href : undefined;
const ATTRACTION_ID = pageUrl ? `${pageUrl}#attraction` : undefined;
const MAPS_SHARE_URL = "https://maps.app.goo.gl/MS8rWseJ7bPBQRrt8";
const GOVT_TOURISM_URL = "https://danangfantasticity.com";
const HERO_IMAGE = pageUrl ? `${pageUrl}con-market-hero-documentary.webp` : undefined;
const attractionSchema = { "@context":"https://schema.org", "@type":["TouristAttraction","LocalBusiness"], "@id":ATTRACTION_ID, name:"Chợ Cồn (Con Market)", alternateName:["Con Market","Chợ Cồn"], inLanguage:["vi","en","zh","ko"], description:"Comprehensive visitor guide to Chợ Cồn (Con Market) in Đà Nẵng, Vietnam.", url:pageUrl, image:HERO_IMAGE?[HERO_IMAGE]:undefined, isAccessibleForFree:true, address:{"@type":"PostalAddress",streetAddress:"90 Hùng Vương",addressLocality:"Hải Châu",addressRegion:"Đà Nẵng",postalCode:"550000",addressCountry:"VN"}, geo:{"@type":"GeoCoordinates",latitude:16.0677927,longitude:108.2049562}, hasMap:MAPS_SHARE_URL, sameAs:[MAPS_SHARE_URL,GOVT_TOURISM_URL], openingHoursSpecification:[{"@type":"OpeningHoursSpecification",dayOfWeek:["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],opens:"06:00",closes:"19:30"}], aggregateRating:{"@type":"AggregateRating",ratingValue:"4.3",reviewCount:"23066",bestRating:"5"} };
const faqSchema = { "@context":"https://schema.org", "@type":"FAQPage", mainEntity:[
  {"@type":"Question",name:"Chợ Cồn có thu phí vào cửa không?",acceptedAnswer:{"@type":"Answer",text:"Không có thông tin về vé vào cổng. Chi phí phát sinh là các món ăn, hàng hóa hoặc dịch vụ bạn tự chọn. / No gate ticket is listed; any cost comes from food, goods or services you choose. / 未列出门票信息；花费仅来自你自选的食品、商品或服务。 / 입장료 정보는 없으며, 비용은 직접 선택한 음식·상품·서비스에 따릅니다."}},
  {"@type":"Question",name:"Nên đến Chợ Cồn vào lúc nào?",acceptedAnswer:{"@type":"Answer",text:"Buổi sáng thường phù hợp nếu muốn xem nhịp chợ thực phẩm; hãy dành thời gian trước buổi chiều muộn vì quầy có thể đóng theo giờ riêng. / Morning suits observing the food trade; allow time before late afternoon as stalls may close on their own schedule. / 若想看食品交易的热闹，清晨较合适；请赶在傍晚前，因为各摊位可能自行打烊。 / 아침은 식료품 장사를 보기에 좋습니다. 오후 늦게 전에는 시간을 내세요. 가게는 각자 시간에 문을 닫을 수 있습니다."}},
  {"@type":"Question",name:"Có thể thanh toán bằng thẻ không?",acceptedAnswer:{"@type":"Answer",text:"Cách thanh toán khác nhau theo từng quầy. Nên mang tiền mặt mệnh giá nhỏ và hỏi giá trước khi gọi món hoặc mua hàng. / Payment varies by stall; carry small-denomination cash and ask the price before ordering or buying. / 各摊位支付方式不同；请携带小额现金，并在点餐或购买前先问价。 / 결제는 가게마다 다릅니다. 소액 현금을 준비하고 주문·구매 전 가격을 물어보세요."}},
  {"@type":"Question",name:"Có bãi đỗ xe không?",acceptedAnswer:{"@type":"Answer",text:"Khả năng gửi xe và vị trí trống thay đổi theo cổng, thời điểm và quy định tại chỗ. Hãy hỏi nhân viên tại khu vực gửi xe, không dừng xe trên lối lưu thông. / Parking availability changes by entrance, time and on-site rules; ask at parking areas and avoid stopping in traffic lanes. / 停车与否及空位随入口、时段和现场规定变化；请咨询停车处工作人员，勿停在车道上。 / 주차 가능 여부와 빈자리는 출입구·시간·현장 규정에 따라 달라집니다. 주차 안내원에게 문의하고 차로를 막지 마세요."}},
  {"@type":"Question",name:"Chợ Cồn ở đâu?",acceptedAnswer:{"@type":"Answer",text:"Chợ Cồn (Con Market) nằm tại 90 Hùng Vương, phường Hải Châu, thành phố Đà Nẵng, Việt Nam. / Chợ Cồn (Con Market) is located at 90 Hùng Vương, Hải Châu, Đà Nẵng, Vietnam. / 昆市场（Con Market）位于越南岘港市海洲郡雄王街90号。 / 꼰 시장(Con Market)은 베트남 다낭시 하이쩌우군 훙ヴュオン 90번지에 있습니다."}},
  {"@type":"Question",name:"Chợ Cồn mở cửa những ngày nào?",acceptedAnswer:{"@type":"Answer",text:"Khu chợ thường được ghi nhận mở cửa hàng ngày từ khoảng 06:00 đến 19:30; giờ của từng quầy có thể khác nhau. / The market is commonly listed as open daily from about 06:00 to 19:30; individual stall hours can differ. / 市场通常每日约 06:00–19:30 营业；各摊位时间可能不同。 / 시장은 보통 매일 약 06:00~19:30 영업하며, 가게마다 시간이 다를 수 있습니다."}},
  {"@type":"Question",name:"Có ăn uống bên trong chợ không?",acceptedAnswer:{"@type":"Answer",text:"Có các quầy ăn, khu thực phẩm và gia vị bên trong chợ; chúng tôi chỉ mô tả dạng trải nghiệm, không đề xuất quầy cụ thể. / The market includes food stalls, fresh-food and spice sections; this guide describes experience types rather than recommending specific stalls. / 市场内有餐饮摊位、生鲜与香料区；本指南仅描述体验类型，不推荐具体摊位。 / 시장 안에는 식당·식료품·향신료 구역이 있습니다. 이 가이드는 체험 유형만 안내하며 특정 가게를 추천하지 않습니다."}},
  {"@type":"Question",name:"Chợ Cồn có an toàn cho du khách không?",acceptedAnswer:{"@type":"Answer",text:"Chợ là không gian công cộng đông đúc; giữ túi gọn, để ý xe máy ở lối ngoài và xin phép trước khi chụp người khác. / The market is a busy public space; keep bags compact, watch for motorcycles on outer lanes and ask before photographing others. / 市场是拥挤的公共场所；请收好包袋、留意外侧车道摩托车，拍摄他人前先征得同意。 / 시장은 붐비는 공공장소입니다. 가방을 가까이 두고 외곽 차로의 오토바이를 조심하며, 타인 촬영 전 허락을 구하세요."}}
] };
---
<BaseLayout title="Chợ Cồn Đà Nẵng — Hướng dẫn du lịch" description="Hướng dẫn độc lập, song ngữ Việt–Anh về Chợ Cồn (Con Market) Đà Nẵng: lịch sử, giao thông, thời tiết, tiện ích, lộ trình và trách nhiệm tham quan." titleEn="Chợ Cồn (Con Market) Đà Nẵng — Travel Guide" descriptionEn="Independent, bilingual Vietnamese–English visitor guide to Chợ Cồn (Con Market) in Đà Nẵng: history, transport, weather, facilities, routes and responsible visiting." titleZh="岘港昆市场（Chợ Cồn）— 旅游指南" descriptionZh="关于岘港昆市场（Chợ Cồn / Con Market）的独立游客指南（越/英/中/韩）：历史、交通、天气、实用信息、路线与负责任游览。" titleKo="다낭 꼰 시장(Con Market) — 여행 가이드" descriptionKo="다낭 꼰 시장(Con Market)에 대한 독립 방문 가이드(베트남어·영어·중국어·한국어): 역사, 교통, 날씨, 편의 정보, 동선, 책임 있는 방문.">
  <header class="hero" id="top"><img class="hero-photo" src="/con-market-hero-documentary.webp" alt="Chợ Cồn (Con Market) — mặt tiền chợ ở Đà Nẵng, Việt Nam" width="800" height="500" /><div class="topbar"><a class="brand" href="#top" aria-label="Chợ Cồn"><img src="/favicon.svg" alt="Biểu tượng Chợ Cồn" width="44" height="44" /><span class="brand-mark"><span class="brand-name">CHỢ CỒN</span><span class="brand-kicker">Đà Nẵng · 90 Hùng Vương</span></span></a><LanguageSwitch /></div><div class="hero-content"><p class="eyebrow" style="color:#F3B23C"><span class="lang-vi">Chợ Cồn (Con Market) · Đà Nẵng · Vietnam</span><span class="lang-en">Chợ Cồn (Con Market) · Đà Nẵng · Vietnam</span><span class="lang-zh">昆市场（Con Market）· 岘港 · 越南</span><span class="lang-ko">꼰 시장(Con Market) · 다낭 · 베트남</span></p><h1 class="display"><span class="lang-vi">Một nhịp chợ<br/>ở giữa thành phố.</span><span class="lang-en">A market rhythm<br/>in the city.</span><span class="lang-zh">城市中央的<br/>一处市集脉动。</span><span class="lang-ko">도시 한가운데의<br/>시장 감각.</span></h1><p class="hero-copy lang-vi">Chợ Cồn là một điểm dừng mang tính đời sống thường ngày: những lối hàng thực phẩm, đồ khô, vải vóc và khu ăn uống tạo nên một lát cắt dễ tiếp cận của Đà Nẵng.</p><p class="hero-copy lang-en">Con Market is a lived-in city stop: food aisles, dried goods, fabrics and eating areas form an accessible slice of everyday Đà Nẵng.</p><p class="hero-copy lang-zh">昆市场是一处充满日常气息的城市驿站：食品摊位、干货、布艺与饮食区共同构成岘港生活化的一面。</p><p class="hero-copy lang-ko">꼰 시장은 일상이 살아 있는 도시의 정거장입니다. 식료품 통로, 건어물, 직물, 식사 구역이 다낭의 일상을 보여줍니다.</p><div class="hero-bottom"><div class="rating-chip" aria-label="Google Maps rating 4.3 from 22,816 reviews"><div><span class="rating-number">4.3</span> <span class="rating-stars">★★★★★</span></div><small><span class="lang-vi">23.066 đánh giá trên Google Maps</span><span class="lang-en">23,066 Google Maps reviews</span><span class="lang-zh">Google Maps 上 23,066 条评价</span><span class="lang-ko">Google Maps 리뷰 23,066개</span></small></div><div class="visit-brief"><p><strong><span class="lang-vi">Giờ thường thấy</span><span class="lang-en">Commonly listed hours</span><span class="lang-zh">通常营业时间</span><span class="lang-ko">일반 영업 시간</span></strong> · 06:00–19:30</p><p><span class="lang-vi">Giờ của từng quầy có thể khác nhau; nên kiểm tra trực tiếp khi đến.</span><span class="lang-en">Individual stall hours can differ; check on arrival.</span><span class="lang-zh">各摊位时间可能不同，到店时请直接确认。</span><span class="lang-ko">가게마다 시간이 다를 수 있으니 방문 시 직접 확인하세요.</span></p></div></div><a class="hero-cta" href="#ban-do"><span class="lang-vi">Xem vị trí & đường đi</span><span class="lang-en">See location & routes</span><span class="lang-zh">查看位置与路线</span><span class="lang-ko">위치 및 경로 보기</span><span aria-hidden="true">↘</span></a></div></header>
  <main>
    <section class="intro-grid" aria-labelledby="intro-title"><div class="section-shell"><div><p class="section-index">01 —</p><p class="eyebrow"><span class="lang-vi">Nhìn nhanh</span><span class="lang-en">At a glance</span><span class="lang-zh">概览</span><span class="lang-ko">한눈에 보기</span></p></div><div class="intro-text"><p class="entity-breadcrumb"><span class="lang-vi">Chợ Cồn (Con Market) → Đà Nẵng → Vietnam</span><span class="lang-en">Chợ Cồn (Con Market) → Đà Nẵng → Vietnam</span><span class="lang-zh">昆市场（Con Market）→ 岘港 → 越南</span><span class="lang-ko">꼰 시장(Con Market) → 다낭 → 베트남</span></p><h2 id="about-title" class="display section-title"><span class="lang-vi">Về Chợ Cồn (Con Market)</span><span class="lang-en">About Chợ Cồn (Con Market)</span><span class="lang-zh">关于昆市场（Con Market）</span><span class="lang-ko">꼰 시장(Con Market) 소개</span></h2><h2 id="intro-title" class="display section-title"><span class="lang-vi">Không phải một điểm tham quan được dàn dựng.</span><span class="lang-en">Not a staged attraction.</span><span class="lang-zh">不是一个被刻意布置的景点。</span><span class="lang-ko">꾸며진 관광지가 아닙니다.</span></h2><p class="lang-vi">Tên “Cồn” gợi lại vị trí hình thành trên một cồn đất cao của Đà Nẵng xưa. Ngày nay, khu chợ vẫn được biết đến như một không gian mua sắm và ẩm thực địa phương, nơi du khách có thể quan sát nhịp giao dịch thường nhật thay vì chỉ ghé qua một khu bán đồ lưu niệm.</p><p class="lang-en">The name “Cồn” recalls the market’s origins on a higher sandbar in old Đà Nẵng. Today, it remains known as a local shopping and food space where visitors can observe daily exchange rather than only pass through a souvenir zone.</p><p class="lang-zh">“Cồn”一名让人联想到旧岘港一处较高的沙丘。如今，它依然是当地人购物与饮食的空间，游客可观察日常交易，而非仅仅穿过纪念品区。</p><p class="lang-ko">“Cồn”이라는 이름은 옛 다낭의 높은 사구(모래언덕)에서 유래했습니다. 오늘날에도 현지 쇼핑·식생활 공간으로, 방문객은 기념품 구역만 지나치는 것이 아니라 일상을 관찰할 수 있습니다.</p><p class="lang-vi">Hướng dẫn này tập trung vào cách tiếp cận địa điểm có trách nhiệm: chuẩn bị thời gian, hỏi giá trước khi mua, tôn trọng lối đi hẹp và coi mỗi quầy là một hoạt động kinh doanh độc lập.</p><p class="lang-en">This guide focuses on visiting responsibly: allow enough time, ask the price before buying, respect narrow aisles, and remember that every stall operates independently.</p><p class="lang-zh">本指南侧重负责任的游览方式：预留足够时间、购买前先问价、尊重狭窄通道，并把每个摊位视为独立经营。</p><p class="lang-ko">이 가이드는 책임 있는 방문에 집중합니다. 충분한 시간을 두고, 구매 전 가격을 묻고, 좁은 통로를 존중하며, 각 가게가 독립 운영임을 기억하세요.</p></div><div class="quick-facts" aria-label="Thông tin nhanh"><div class="fact"><div class="fact-icon">A</div><div><h3><span class="lang-vi">Địa chỉ</span><span class="lang-en">Address</span><span class="lang-zh">地址</span><span class="lang-ko">주소</span></h3><p>90 Hùng Vương, Hải Châu, Đà Nẵng 550000</p></div></div><div class="fact"><div class="fact-icon">◷</div><div><h3><span class="lang-vi">Thời lượng</span><span class="lang-en">Time to allow</span><span class="lang-zh">建议时长</span><span class="lang-ko">권장 시간</span></h3><p><span class="lang-vi">Khoảng 60–120 phút, tùy mục đích ăn uống hay mua sắm.</span><span class="lang-en">About 60–120 minutes, depending on whether you eat or browse.</span><span class="lang-zh">约 60–120 分钟，视用餐或闲逛而定。</span><span class="lang-ko">식사 여부에 따라 약 60~120분.</span></p></div></div><div class="fact"><div class="fact-icon">₫</div><div><h3><span class="lang-vi">Vào cửa</span><span class="lang-en">Entry</span><span class="lang-zh">门票</span><span class="lang-ko">입장</span></h3><p><span class="lang-vi">Không có thông tin về vé cổng; chi tiêu tùy theo lựa chọn của bạn.</span><span class="lang-en">No gate ticket is listed; spending depends on your choices.</span><span class="lang-zh">未列出门票信息；花费取决于你的选择。</span><span class="lang-ko">입장료 정보는 없으며, 지출은 선택에 따릅니다.</span></p></div></div><div class="fact"><div class="fact-icon">↔</div><div><h3><span class="lang-vi">Điểm lưu ý</span><span class="lang-en">Good to know</span><span class="lang-zh">温馨提示</span><span class="lang-ko">알아두면 좋아요</span></h3><p><span class="lang-vi">Lối đi và các quầy có thể đông vào giờ cao điểm.</span><span class="lang-en">Aisles and stalls can be busy at peak times.</span><span class="lang-zh">高峰时段通道与摊位可能拥挤。</span><span class="lang-ko">통로와 가게는 피크타임에 붐빌 수 있습니다.</span></p></div></div></div></div></section>
    <WeatherSection />
    <HistorySection />
    <section class="photo-break" aria-label="Inside the market"><img src="/con-market-hall.jpg" alt="Bên trong Chợ Cồn (Con Market) tại Đà Nẵng" width="735" height="498" loading="lazy" /><div class="photo-caption"><p class="eyebrow" style="color:#F3B23C"><span class="lang-vi">Một cách ghé chợ</span><span class="lang-en">One way to visit</span><span class="lang-zh">一种逛法</span><span class="lang-ko">시장을 즐기는 법</span></p><h2 class="display"><span class="lang-vi">Đi chậm. Nhìn trước. Hỏi rõ.</span><span class="lang-en">Move slowly. Look first. Ask clearly.</span><span class="lang-zh">慢步走。先看。问清楚。</span><span class="lang-ko">천천히 걷기. 먼저 살피기. 똑똑히 묻기.</span></h2><p class="lang-vi">Buổi sáng thường hợp với người muốn quan sát khu thực phẩm. Khi chợ đông, hãy đứng gọn về một bên, không chặn lối đi và tránh quay cận mặt người bán khi chưa được đồng ý.</p><p class="lang-en">Morning often suits visitors who want to observe food trading. When it is busy, keep to one side of the aisle and avoid close-up filming of vendors without permission.</p><p class="lang-zh">清晨适合想观察食品交易的人。人多时请靠边站立、不要挡路，未经同意勿近距离拍摄摊主。</p><p class="lang-ko">아침은 식료품 장사를 관찰하기 좋습니다. 붐비면 통로 한쪽으로 물러서고, 허락 없이 가게 주인을 클로즈업 촬영하지 마세요.</p></div></section>
    <section class="trail" aria-labelledby="route-title"><div class="section-shell"><div><p class="section-index">04 —</p><p class="eyebrow" style="color:#F3B23C"><span class="lang-vi">Thời điểm & nhịp điệu</span><span class="lang-en">Timing & rhythm</span><span class="lang-zh">时段与节奏</span><span class="lang-ko">시간대와 리듬</span></p></div><div><h2 id="route-title" class="display section-title"><span class="lang-vi">Chọn giờ theo điều bạn muốn quan sát.</span><span class="lang-en">Choose the hour for what you want to observe.</span><span class="lang-zh">按你想看的内容选择时段。</span><span class="lang-ko">보고 싶은 것을 위해 시간을 고르세요.</span></h2></div><ol class="trail-list"><li><h3><span class="lang-vi">Buổi sớm · khoảng 06:00–09:00</span><span class="lang-en">Early morning · about 06:00–09:00</span><span class="lang-zh">清晨 · 约 06:00–09:00</span><span class="lang-ko">이른 아침 · 약 06:00~09:00</span></h3><p class="lang-vi">Phù hợp để cảm nhận nhịp mua bán thực phẩm hằng ngày. Đây cũng có thể là lúc một số lối đi bận rộn nhất.</p><p class="lang-en">Good for sensing the daily food trade. It can also be one of the busiest moments in the aisles.</p><p class="lang-zh">适合感受每日食品交易的气氛，也是部分通道最繁忙的时段。</p><p class="lang-ko">매일의 식료품 장사를 느끼기에 좋습니다. 통로가 가장 붐비는 때이기도 합니다.</p></li><li><h3><span class="lang-vi">Giữa buổi · khoảng 09:00–11:30</span><span class="lang-en">Late morning · about 09:00–11:30</span><span class="lang-zh">上午 · 约 09:00–11:30</span><span class="lang-ko">오전 · 약 09:00~11:30</span></h3><p class="lang-vi">Một lựa chọn cân bằng cho việc ăn uống và tìm hiểu các khu hàng, nếu bạn muốn tránh phần đông nhất của buổi sớm.</p><p class="lang-en">A balanced time for eating and browsing stalls if you wish to miss the most intense early-morning rush.</p><p class="lang-zh">若想避开最拥挤的清晨，上午是就餐与逛摊的均衡选择。</p><p class="lang-ko">이른 아침 혼잡을 피하고 싶다면 식사와 둘러보기에 균형 잡힌 시간입니다.</p></li><li><h3><span class="lang-vi">Sau trưa · khoảng 13:30–16:30</span><span class="lang-en">Afternoon · about 13:30–16:30</span><span class="lang-zh">午后 · 约 13:30–16:30</span><span class="lang-ko">오후 · 약 13:30~16:30</span></h3><p class="lang-vi">Nên giữ kỳ vọng linh hoạt: giờ mở và nguồn hàng phụ thuộc từng quầy. Trời nóng hơn, vì vậy nước uống và trang phục thoáng là hữu ích.</p><p class="lang-en">Keep expectations flexible: hours and stock are stall-specific. Heat can be stronger, so water and light clothing help.</p><p class="lang-zh">请保持灵活：营业与货源因摊而异。天气更热，饮水与透气衣物有帮助。</p><p class="lang-ko">기대치를 유연하게 두세요. 시간과 재고는 가게마다 다릅니다. 더울 수 있으니 물과 통풍 좋은 옷이 도움이 됩니다.</p></li></ol></div></section>
    <section class="practical" aria-labelledby="practical-title"><div class="section-shell"><div><p class="section-index">05 —</p><p class="eyebrow"><span class="lang-vi">Tiện ích thiết yếu</span><span class="lang-en">Practical notes</span><span class="lang-zh">实用信息</span><span class="lang-ko">실용 정보</span></p></div><div><h2 id="practical-title" class="display section-title"><span class="lang-vi">Thông tin thực tế trước khi rẽ vào lối chợ.</span><span class="lang-en">Practical notes before you turn into the market.</span><span class="lang-zh">拐进市场前须知。</span><span class="lang-ko">시장으로 들어서기 전 실용 정보.</span></h2><p class="intro-text lang-vi">Đây là các gợi ý định hướng trung lập, không thay thế tình trạng thực tế tại chỗ. Hãy hỏi nhân viên hoặc biển chỉ dẫn khi cần hỗ trợ.</p><p class="intro-text lang-en">These are neutral orientation notes, not a substitute for conditions on the day. Ask staff or follow posted signs whenever you need help.</p><p class="intro-text lang-zh">以下为中性引导，不替代当天实际情况。需要帮助时请咨询工作人员或留意指示牌。</p><p class="intro-text lang-ko">이는 중립적인 안내일 뿐 당일 상황을 대신하지 않습니다. 도움이 필요하면 직원이나 안내판을 참고하세요.</p></div></div><div class="field-guide"><article class="field-card"><span class="card-number">01</span><h3><span class="lang-vi">Nhà vệ sinh</span><span class="lang-en">Restrooms</span><span class="lang-zh">洗手间</span><span class="lang-ko">화장실</span></h3><p class="lang-vi">Tiện ích có thể nằm trong hoặc gần khu chợ; vị trí và điều kiện sử dụng thay đổi. Hỏi hướng dẫn tại cổng hoặc quầy quản lý.</p><p class="lang-en">Facilities may be inside or close to the market; locations and conditions can vary. Ask at an entrance or management point.</p><p class="lang-zh">洗手间可能在市场内或附近，位置与条件不一，可在入口或管理处询问。</p><p class="lang-ko">화장실은 시장 안팎에 있을 수 있으며 위치·상태가 다릅니다. 입구나 안내소에 문의하세요.</p></article><article class="field-card"><span class="card-number">02</span><h3><span class="lang-vi">Gửi xe</span><span class="lang-en">Parking</span><span class="lang-zh">停车</span><span class="lang-ko">주차</span></h3><p class="lang-vi">Khu gửi xe máy hoặc ô tô phụ thuộc cổng, thời điểm và quy định tại chỗ. Không dừng đỗ trên làn xe lưu thông.</p><p class="lang-en">Motorcycle or car parking depends on the entrance, time and on-site rules. Do not stop in active traffic lanes.</p><p class="lang-zh">摩托车或汽车停车取决于入口、时段和现场规定，勿在车道上停靠。</p><p class="lang-ko">오토바이·승용차 주차는 출입구·시간·현장 규정에 따릅니다. 차로에 정차하지 마세요.</p></article><article class="field-card"><span class="card-number">03</span><h3><span class="lang-vi">Ăn uống & lưu trú</span><span class="lang-en">Food & stays</span><span class="lang-zh">餐饮与住宿</span><span class="lang-ko">식사와 숙소</span></h3><p class="lang-vi">Trong khu vực có dạng quầy ăn, chợ thực phẩm và nhiều loại hình lưu trú đô thị. Chúng tôi không xếp hạng hoặc đề xuất cơ sở cụ thể.</p><p class="lang-en">The area includes food stalls, market foods and several forms of urban accommodation. This guide does not rank or endorse specific businesses.</p><p class="lang-zh">周边有餐饮摊位、市场食品与多种城市住宿；本指南不排名也不推荐具体商家。</p><p class="lang-ko">이 일대에는 식당, 시장 음식, 여러 도시 숙소가 있습니다. 이 가이드는 특정 업체를 추천하지 않습니다.</p></article><article class="field-card"><span class="card-number">04</span><h3><span class="lang-vi">Mua sắm thiết yếu</span><span class="lang-en">Essentials</span><span class="lang-zh">日用采购</span><span class="lang-ko">생필품</span></h3><p class="lang-vi">Các dịch vụ như cửa hàng tiện lợi, siêu thị, hiệu thuốc và máy rút tiền có thể tìm thấy trong khu đô thị xung quanh.</p><p class="lang-en">Convenience shops, supermarkets, pharmacies and cash points may be found in the surrounding urban area.</p><p class="lang-zh">便利店、超市、药店与提款机可在周边城区找到。</p><p class="lang-ko">편의점, 슈퍼, 약국, 현금 인출기는 주변 도심에서 찾을 수 있습니다.</p></article><article class="field-card"><span class="card-number">05</span><h3><span class="lang-vi">Nhiên liệu & sạc</span><span class="lang-en">Fuel & charging</span><span class="lang-zh">加油与充电</span><span class="lang-ko">주유와 충전</span></h3><p class="lang-vi">Người lái xe nên lên kế hoạch nạp nhiên liệu hoặc sạc tại các khu dịch vụ đô thị phù hợp, không dựa vào không gian chợ.</p><p class="lang-en">Drivers should plan fuel or charging at appropriate urban service areas, rather than relying on the market itself.</p><p class="lang-zh">驾驶者应在合适的城区服务站加油或充电，不要依赖市场本身。</p><p class="lang-ko">운전자는 시장이 아닌 적절한 도심 서비스 구역에서 주유·충전을 계획하세요.</p></article><article class="field-card"><span class="card-number">06</span><h3><span class="lang-vi">Thanh toán</span><span class="lang-en">Payment</span><span class="lang-zh">支付</span><span class="lang-ko">결제</span></h3><p class="lang-vi">Phương thức thanh toán do từng quầy quyết định. Tiền mặt mệnh giá nhỏ giúp việc thanh toán linh hoạt hơn; hãy hỏi giá trước.</p><p class="lang-en">Payment methods are decided by individual stalls. Small-denomination cash can be flexible; ask the price before ordering or buying.</p><p class="lang-zh">支付方式由各摊位决定；小额现金更灵活，请先问价。</p><p class="lang-ko">결제는 가게마다 다릅니다. 소액 현금이 유리하며, 먼저 가격을 물어보세요.</p></article><article class="field-card"><span class="card-number">07</span><h3><span class="lang-vi">Khả năng tiếp cận</span><span class="lang-en">Access</span><span class="lang-zh">无障碍</span><span class="lang-ko">접근성</span></h3><p class="lang-vi">Mặt bằng, bậc thềm và độ rộng lối đi thay đổi theo khu. Người cần hỗ trợ di chuyển nên đi cùng người đồng hành và hỏi trước tại chỗ.</p><p class="lang-en">Surfaces, steps and aisle widths vary by section. Visitors who need mobility assistance should travel with a companion and ask on arrival.</p><p class="lang-zh">地面、台阶与通道宽度因区域而异；需要行动协助者请结伴并在现场先询问。</p><p class="lang-ko">바닥·계단·통로 폭은 구역마다 다릅니다. 이동 보조가 필요하면 동행하고 현장에 미리 문의하세요.</p></article><article class="field-card"><span class="card-number">08</span><h3><span class="lang-vi">Tôn trọng không gian</span><span class="lang-en">Shared space</span><span class="lang-zh">尊重空间</span><span class="lang-ko">공간 배려</span></h3><p class="lang-vi">Giữ túi gọn, quan sát xe máy ở lối ngoài chợ và xin phép trước khi chụp người khác. Điều này giúp lối đi an toàn hơn cho mọi người.</p><p class="lang-en">Keep bags compact, watch for motorcycles on outer lanes and ask before photographing others. It keeps the space safer for everyone.</p><p class="lang-zh">收好包袋、留意外侧车道摩托车，拍摄他人前先征得同意，让通道更安全。</p><p class="lang-ko">가방을 가까이 두고 외곽 차로의 오토바이를 조심하며, 타인 촬영 전 허락을 구하세요. 모두를 위한 안전입니다.</p></article></div></section>
    <TransportGuide />
    <section class="tastes" aria-labelledby="food-title"><div class="image-panel"><img src="/con-market-spices.jpg" alt="Thực phẩm và gia vị tại Chợ Cồn (Con Market), Đà Nẵng" width="1024" height="683" loading="lazy" /></div><div class="section-shell"><div><p class="section-index">07 —</p><p class="eyebrow"><span class="lang-vi">Ẩm thực quanh chợ</span><span class="lang-en">Food around the market</span><span class="lang-zh">市场周边美食</span><span class="lang-ko">시장 주변 음식</span></p></div><div><h2 id="food-title" class="display section-title"><span class="lang-vi">Tìm hiểu theo nhóm món, không theo danh sách phải thử.</span><span class="lang-en">Explore by food type, not a must-eat list.</span><span class="lang-zh">按食物类型了解，而非必吃清单。</span><span class="lang-ko">꼭 먹어야 할 목록이 아닌, 음식 유형별로 살펴보세요.</span></h2><p class="intro-text lang-vi">Chợ Cồn thường được nhắc tới cùng văn hóa ăn vặt và nguyên liệu địa phương. Chúng tôi chỉ giới thiệu dạng trải nghiệm để giữ thông tin trung lập, không nêu tên hay khuyến nghị quầy cụ thể.</p><p class="intro-text lang-en">Con Market is commonly associated with local snacks and ingredients. To remain neutral, we describe types of experiences rather than name or recommend individual stalls.</p><p class="intro-text lang-zh">昆市场常与当地小吃和食材联系在一起。为保持中立，我们只介绍体验类型，不点名或推荐具体摊位。</p><p class="intro-text lang-ko">꼰 시장은 현지 간식과 식재료로 알려져 있습니다. 중립을 위해 특정 가게를 지목하거나 추천하지 않고 체험 유형만 안내합니다.</p><div class="food-list"><article class="food-item"><b>01</b><div><h3><span class="lang-vi">Khu món ăn chế biến tại chỗ</span><span class="lang-en">Prepared-food areas</span><span class="lang-zh">现做餐饮区</span><span class="lang-ko">조리 식사 구역</span></h3><p class="lang-vi">Phù hợp khi bạn muốn gọi phần nhỏ và ăn tại chỗ; hỏi thành phần nếu có dị ứng hoặc chế độ ăn riêng.</p><p class="lang-en">Useful for small, eat-on-site portions; ask about ingredients when you have allergies or dietary needs.</p><p class="lang-zh">适合点小份、就地用餐；如有过敏或特殊饮食请询问成分。</p><p class="lang-ko">소량 즉석 식사에 좋습니다. 알레르기나 식이 제한이 있으면 재료를 물어보세요.</p></div></article><article class="food-item"><b>02</b><div><h3><span class="lang-vi">Đồ khô, gia vị & thực phẩm đóng gói</span><span class="lang-en">Dried goods, spices & packaged foods</span><span class="lang-zh">干货、香料与包装食品</span><span class="lang-ko">건어물·향신료·포장 식품</span></h3><p class="lang-vi">Kiểm tra bao bì, hạn dùng và điều kiện mang theo khi di chuyển bằng máy bay hoặc qua biên giới.</p><p class="lang-en">Check packaging, use-by details and transport rules for air travel or borders.</p><p class="lang-zh">乘机或跨境时请检查包装、保质期与携带规定。</p><p class="lang-ko">비행기나 국경 이동 시 포장, 유통기한, 반입 규정을 확인하세요.</p></div></article><article class="food-item"><b>03</b><div><h3><span class="lang-vi">Trái cây & nông sản theo mùa</span><span class="lang-en">Seasonal fruit & produce</span><span class="lang-zh">时令水果与农产</span><span class="lang-ko">제철 과일·농산물</span></h3><p class="lang-vi">Hãy hỏi giá theo đơn vị, chọn hàng phù hợp thời gian sử dụng và cân nhắc nhiệt độ khi mang đi xa.</p><p class="lang-en">Ask how prices are measured, choose items for your time frame, and consider heat when carrying them away.</p><p class="lang-zh">请询问计价单位，按使用时间挑选，并考虑远途携带时的温度。</p><p class="lang-ko">단위 가격을 묻고 사용 시점에 맞춰 고르며, 멀리 갈 때 온도를 고려하세요.</p></div></article></div></div></div></section>
    <section class="nearby" aria-labelledby="nearby-title"><div class="section-shell"><div><p class="section-index">08 —</p><p class="eyebrow" style="color:#F3B23C"><span class="lang-vi">Tiếp tục chuyến đi</span><span class="lang-en">Continue the trip</span><span class="lang-zh">继续行程</span><span class="lang-ko">여정 이어가기</span></p></div><div><h2 id="nearby-title" class="display section-title"><span class="lang-vi">Ghép chợ vào một vòng đi bộ trong trung tâm.</span><span class="lang-en">Fold the market into a central-city walk.</span><span class="lang-zh">把市场纳入市中心步行圈。</span><span class="lang-ko">시장을 도심 산책에 더하기.</span></h2><p class="intro-text lang-vi">Các điểm dưới đây thuộc vùng trung tâm rộng hơn. Chọn theo sức đi bộ, thời tiết và giờ mở cửa cập nhật tại nguồn chính thức; không coi đây là thứ tự ưu tiên.</p><p class="intro-text lang-en">The places below sit in the wider central area. Choose by walking comfort, weather and up-to-date official opening information; this is not a ranking.</p><p class="intro-text lang-zh">以下地点位于更大的中心区域。请按步行体力、天气与官方最新开放信息选择，并非优先级排序。</p><p class="intro-text lang-ko">아래 장소는 넓은 도심에 있습니다. 걷기 편함·날씨·최신 공식 개장 정보로 고르세요. 순위가 아닙니다.</p></div></div><div class="nearby-grid"><article class="nearby-item"><small><span class="lang-vi">Chợ truyền thống</span><span class="lang-en">Traditional market</span><span class="lang-zh">传统市场</span><span class="lang-ko">전통 시장</span></small><h3><span class="lang-vi">Chợ Hàn</span><span class="lang-en">Hàn Market</span><span class="lang-zh">韩市场</span><span class="lang-ko">한 시장</span></h3><p class="lang-vi">Một không gian chợ khác ở trung tâm; có thể giúp bạn so sánh nhịp mua bán tại các khu phố khác nhau.</p><p class="lang-en">Another central market setting, offering a comparison with a different part of the city.</p><p class="lang-zh">市中心的另一处市场，便于你对比不同街区的交易氛围。</p><p class="lang-ko">도심의 또 다른 시장으로, 다른 동네의 장사 풍경을 비교해 볼 수 있습니다.</p></article><article class="nearby-item"><small><span class="lang-vi">Di sản đô thị</span><span class="lang-en">Urban heritage</span><span class="lang-zh">城市遗产</span><span class="lang-ko">도심 유산</span></small><h3><span class="lang-vi">Nhà thờ Chính tòa Đà Nẵng</span><span class="lang-en">Đà Nẵng Cathedral</span><span class="lang-zh">岘港大教堂</span><span class="lang-ko">다낭 대성당</span></h3><p class="lang-vi">Một điểm kiến trúc trong khu trung tâm, phù hợp để quan sát cảnh quan phố phường từ bên ngoài khi di chuyển.</p><p class="lang-en">A central architectural landmark, suitable for observing the streetscape from the outside while moving through town.</p><p class="lang-zh">市中心的地标建筑，途中可从外部欣赏街景。</p><p class="lang-ko">도심 건축 랜드마크로, 이동 중 외부에서 거리를 감상하기 좋습니다.</p></article><article class="nearby-item"><small><span class="lang-vi">Bảo tàng</span><span class="lang-en">Museum</span><span class="lang-zh">博物馆</span><span class="lang-ko">박물관</span></small><h3><span class="lang-vi">Bảo tàng Điêu khắc Chăm</span><span class="lang-en">Museum of Cham Sculpture</span><span class="lang-zh">占族雕塑博物馆</span><span class="lang-ko">참 조각 박물관</span></h3><p class="lang-vi">Điểm tìm hiểu lịch sử – văn hóa với nhịp tham quan khác hẳn khu chợ; kiểm tra thông tin vé và giờ mở cửa trước chuyến đi.</p><p class="lang-en">A history-and-culture stop with a very different pace from the market; check ticketing and opening details before visiting.</p><p class="lang-zh">历史与文化的去处，节奏与市场对迥异；前往前请查票价与开放信息。</p><p class="lang-ko">시장과는 전혀 다른 호흡의 역사·문화 명소입니다. 방문 전 관람권과 개장 정보를 확인하세요.</p></article></div></section>

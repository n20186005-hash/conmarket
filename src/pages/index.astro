---
// Style reminder: the home page is a walk through a traditional Vietnamese market—real photographs make the place tangible, while indigo print motifs organize facts and movement.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WeatherSection from "../components/WeatherSection.astro";
import HistorySection from "../components/HistorySection.astro";
import TransportGuide from "../components/TransportGuide.astro";
import SeasonalStrategy from "../components/SeasonalStrategy.astro";
import Itineraries from "../components/Itineraries.astro";
import VisitorResponsibility from "../components/VisitorResponsibility.astro";
export const prerender = true;
const pageUrl = Astro.site ? new URL("/", Astro.site).href : undefined;
const ATTRACTION_ID = pageUrl ? `${pageUrl}#attraction` : undefined;
const MAPS_SHARE_URL = "https://maps.app.goo.gl/MS8rWseJ7bPBQRrt8";
const GOVT_TOURISM_URL = "https://danangfantasticity.com";
const HERO_IMAGE = pageUrl ? `${pageUrl}con-market-hero-documentary.webp` : undefined;
const attractionSchema = { "@context":"https://schema.org", "@type":["TouristAttraction","LocalBusiness"], "@id":ATTRACTION_ID, name:"Chợ Cồn (Con Market)", alternateName:["Con Market","Chợ Cồn"], description:"Comprehensive visitor guide to Chợ Cồn (Con Market) in Đà Nẵng, Vietnam.", url:pageUrl, image:HERO_IMAGE?[HERO_IMAGE]:undefined, isAccessibleForFree:true, address:{"@type":"PostalAddress",streetAddress:"90 Hùng Vương",addressLocality:"Hải Châu",addressRegion:"Đà Nẵng",postalCode:"550000",addressCountry:"VN"}, geo:{"@type":"GeoCoordinates",latitude:16.0677927,longitude:108.2049562}, hasMap:MAPS_SHARE_URL, sameAs:[MAPS_SHARE_URL,GOVT_TOURISM_URL], openingHoursSpecification:[{"@type":"OpeningHoursSpecification",dayOfWeek:["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],opens:"06:00",closes:"19:30"}], aggregateRating:{"@type":"AggregateRating",ratingValue:"4.3",reviewCount:"23066",bestRating:"5"} };
const faqSchema = { "@context":"https://schema.org", "@type":"FAQPage", mainEntity:[
  {"@type":"Question",name:"Chợ Cồn có thu phí vào cửa không?",acceptedAnswer:{"@type":"Answer",text:"Không có thông tin về vé vào cổng. Chi phí phát sinh là các món ăn, hàng hóa hoặc dịch vụ bạn tự chọn. / No gate ticket is listed; any cost comes from food, goods or services you choose."}},
  {"@type":"Question",name:"Nên đến Chợ Cồn vào lúc nào?",acceptedAnswer:{"@type":"Answer",text:"Buổi sáng thường phù hợp nếu muốn xem nhịp chợ thực phẩm; hãy dành thời gian trước buổi chiều muộn vì quầy có thể đóng theo giờ riêng. / Morning suits observing the food trade; allow time before late afternoon as stalls may close on their own schedule."}},
  {"@type":"Question",name:"Có thể thanh toán bằng thẻ không?",acceptedAnswer:{"@type":"Answer",text:"Cách thanh toán khác nhau theo từng quầy. Nên mang tiền mặt mệnh giá nhỏ và hỏi giá trước khi gọi món hoặc mua hàng. / Payment varies by stall; carry small-denomination cash and ask the price before ordering or buying."}},
  {"@type":"Question",name:"Có bãi đỗ xe không?",acceptedAnswer:{"@type":"Answer",text:"Khả năng gửi xe và vị trí trống thay đổi theo cổng, thời điểm và quy định tại chỗ. Hãy hỏi nhân viên tại khu vực gửi xe, không dừng xe trên lối lưu thông. / Parking availability changes by entrance, time and on-site rules; ask at parking areas and avoid stopping in traffic lanes."}},
  {"@type":"Question",name:"Chợ Cồn ở đâu?",acceptedAnswer:{"@type":"Answer",text:"Chợ Cồn (Con Market) nằm tại 90 Hùng Vương, phường Hải Châu, thành phố Đà Nẵng, Việt Nam. / Chợ Cồn (Con Market) is located at 90 Hùng Vương, Hải Châu, Đà Nẵng, Vietnam."}},
  {"@type":"Question",name:"Chợ Cồn mở cửa những ngày nào?",acceptedAnswer:{"@type":"Answer",text:"Khu chợ thường được ghi nhận mở cửa hàng ngày từ khoảng 06:00 đến 19:30; giờ của từng quầy có thể khác nhau. / The market is commonly listed as open daily from about 06:00 to 19:30; individual stall hours can differ."}},
  {"@type":"Question",name:"Có ăn uống bên trong chợ không?",acceptedAnswer:{"@type":"Answer",text:"Có các quầy ăn, khu thực phẩm và gia vị bên trong chợ; chúng tôi chỉ mô tả dạng trải nghiệm, không đề xuất quầy cụ thể. / The market includes food stalls, fresh-food and spice sections; this guide describes experience types rather than recommending specific stalls."}},
  {"@type":"Question",name:"Chợ Cồn có an toàn cho du khách không?",acceptedAnswer:{"@type":"Answer",text:"Chợ là không gian công cộng đông đúc; giữ túi gọn, để ý xe máy ở lối ngoài và xin phép trước khi chụp người khác. / The market is a busy public space; keep bags compact, watch for motorcycles on outer lanes and ask before photographing others."}}
] };
---
<BaseLayout title="Chợ Cồn Đà Nẵng — Hướng dẫn du lịch" description="Hướng dẫn độc lập, song ngữ Việt–Anh về Chợ Cồn (Con Market) Đà Nẵng: lịch sử, giao thông, thời tiết, tiện ích, lộ trình và trách nhiệm tham quan.">
  <header class="hero" id="top"><img class="hero-photo" src="/con-market-hero-documentary.webp" alt="Chợ Cồn (Con Market) — mặt tiền chợ ở Đà Nẵng, Việt Nam" width="800" height="500" /><div class="topbar"><a class="brand" href="#top" aria-label="Chợ Cồn"><img src="/favicon.svg" alt="Biểu tượng Chợ Cồn" width="44" height="44" /><span class="brand-mark"><span class="brand-name">CHỢ CỒN</span><span class="brand-kicker">Đà Nẵng · 90 Hùng Vương</span></span></a><LanguageSwitch /></div><div class="hero-content"><p class="eyebrow" style="color:#F3B23C">Chợ Cồn (Con Market) · Đà Nẵng · Vietnam</p><h1 class="display"><span class="lang-vi">Một nhịp chợ<br/>ở giữa thành phố.</span><span class="lang-en">A market rhythm<br/>in the city.</span></h1><p class="hero-copy lang-vi">Chợ Cồn là một điểm dừng mang tính đời sống thường ngày: những lối hàng thực phẩm, đồ khô, vải vóc và khu ăn uống tạo nên một lát cắt dễ tiếp cận của Đà Nẵng.</p><p class="hero-copy lang-en">Con Market is a lived-in city stop: food aisles, dried goods, fabrics and eating areas form an accessible slice of everyday Đà Nẵng.</p><div class="hero-bottom"><div class="rating-chip" aria-label="Google Maps rating 4.3 from 22,816 reviews"><div><span class="rating-number">4.3</span> <span class="rating-stars">★★★★★</span></div><small><span class="lang-vi">23.066 đánh giá trên Google Maps</span><span class="lang-en">23,066 Google Maps reviews</span></small></div><div class="visit-brief"><p><strong><span class="lang-vi">Giờ thường thấy</span><span class="lang-en">Commonly listed hours</span></strong> · 06:00–19:30</p><p><span class="lang-vi">Giờ của từng quầy có thể khác nhau; nên kiểm tra trực tiếp khi đến.</span><span class="lang-en">Individual stall hours can differ; check on arrival.</span></p></div></div><a class="hero-cta" href="#ban-do"><span class="lang-vi">Xem vị trí & đường đi</span><span class="lang-en">See location & routes</span><span aria-hidden="true">↘</span></a></div></header>
  <main>
    <section class="intro-grid" aria-labelledby="intro-title"><div class="section-shell"><div><p class="section-index">01 —</p><p class="eyebrow">Nhìn nhanh</p></div><div class="intro-text"><p class="entity-breadcrumb">Chợ Cồn (Con Market) → Đà Nẵng → Vietnam</p><h2 id="about-title" class="display section-title"><span class="lang-vi">Về Chợ Cồn (Con Market)</span><span class="lang-en">About Chợ Cồn (Con Market)</span></h2><h2 id="intro-title" class="display section-title"><span class="lang-vi">Không phải một điểm tham quan được dàn dựng.</span><span class="lang-en">Not a staged attraction.</span></h2><p class="lang-vi">Tên “Cồn” gợi lại vị trí hình thành trên một cồn đất cao của Đà Nẵng xưa. Ngày nay, khu chợ vẫn được biết đến như một không gian mua sắm và ẩm thực địa phương, nơi du khách có thể quan sát nhịp giao dịch thường nhật thay vì chỉ ghé qua một khu bán đồ lưu niệm.</p><p class="lang-en">The name “Cồn” recalls the market’s origins on a higher sandbar in old Đà Nẵng. Today, it remains known as a local shopping and food space where visitors can observe daily exchange rather than only pass through a souvenir zone.</p><p class="lang-vi">Hướng dẫn này tập trung vào cách tiếp cận địa điểm có trách nhiệm: chuẩn bị thời gian, hỏi giá trước khi mua, tôn trọng lối đi hẹp và coi mỗi quầy là một hoạt động kinh doanh độc lập.</p><p class="lang-en">This guide focuses on visiting responsibly: allow enough time, ask the price before buying, respect narrow aisles, and remember that every stall operates independently.</p></div><div class="quick-facts" aria-label="Thông tin nhanh"><div class="fact"><div class="fact-icon">A</div><div><h3><span class="lang-vi">Địa chỉ</span><span class="lang-en">Address</span></h3><p>90 Hùng Vương, Hải Châu, Đà Nẵng 550000</p></div></div><div class="fact"><div class="fact-icon">◷</div><div><h3><span class="lang-vi">Thời lượng</span><span class="lang-en">Time to allow</span></h3><p><span class="lang-vi">Khoảng 60–120 phút, tùy mục đích ăn uống hay mua sắm.</span><span class="lang-en">About 60–120 minutes, depending on whether you eat or browse.</span></p></div></div><div class="fact"><div class="fact-icon">₫</div><div><h3><span class="lang-vi">Vào cửa</span><span class="lang-en">Entry</span></h3><p><span class="lang-vi">Không có thông tin về vé cổng; chi tiêu tùy theo lựa chọn của bạn.</span><span class="lang-en">No gate ticket is listed; spending depends on your choices.</span></p></div></div><div class="fact"><div class="fact-icon">↔</div><div><h3><span class="lang-vi">Điểm lưu ý</span><span class="lang-en">Good to know</span></h3><p><span class="lang-vi">Lối đi và các quầy có thể đông vào giờ cao điểm.</span><span class="lang-en">Aisles and stalls can be busy at peak times.</span></p></div></div></div></div></section>
    <WeatherSection />
    <HistorySection />
    <section class="photo-break" aria-label="Nhịp bên trong chợ"><img src="/con-market-hall.jpg" alt="Bên trong Chợ Cồn (Con Market) tại Đà Nẵng" width="735" height="498" loading="lazy" /><div class="photo-caption"><p class="eyebrow" style="color:#F3B23C">Một cách ghé chợ</p><h2 class="display"><span class="lang-vi">Đi chậm. Nhìn trước. Hỏi rõ.</span><span class="lang-en">Move slowly. Look first. Ask clearly.</span></h2><p class="lang-vi">Buổi sáng thường hợp với người muốn quan sát khu thực phẩm. Khi chợ đông, hãy đứng gọn về một bên, không chặn lối đi và tránh quay cận mặt người bán khi chưa được đồng ý.</p><p class="lang-en">Morning often suits visitors who want to observe food trading. When it is busy, keep to one side of the aisle and avoid close-up filming of vendors without permission.</p></div></section>
    <section class="trail" aria-labelledby="route-title"><div class="section-shell"><div><p class="section-index">04 —</p><p class="eyebrow" style="color:#F3B23C">Thời điểm & nhịp điệu</p><h2 id="route-title" class="display section-title"><span class="lang-vi">Chọn giờ theo điều bạn muốn quan sát.</span><span class="lang-en">Choose the hour for what you want to observe.</span></h2></div><ol class="trail-list"><li><h3><span class="lang-vi">Buổi sớm · khoảng 06:00–09:00</span><span class="lang-en">Early morning · about 06:00–09:00</span></h3><p class="lang-vi">Phù hợp để cảm nhận nhịp mua bán thực phẩm hằng ngày. Đây cũng có thể là lúc một số lối đi bận rộn nhất.</p><p class="lang-en">Good for sensing the daily food trade. It can also be one of the busiest moments in the aisles.</p></li><li><h3><span class="lang-vi">Giữa buổi · khoảng 09:00–11:30</span><span class="lang-en">Late morning · about 09:00–11:30</span></h3><p class="lang-vi">Một lựa chọn cân bằng cho việc ăn uống và tìm hiểu các khu hàng, nếu bạn muốn tránh phần đông nhất của buổi sớm.</p><p class="lang-en">A balanced time for eating and browsing stalls if you wish to miss the most intense early-morning rush.</p></li><li><h3><span class="lang-vi">Sau trưa · khoảng 13:30–16:30</span><span class="lang-en">Afternoon · about 13:30–16:30</span></h3><p class="lang-vi">Nên giữ kỳ vọng linh hoạt: giờ mở và nguồn hàng phụ thuộc từng quầy. Trời nóng hơn, vì vậy nước uống và trang phục thoáng là hữu ích.</p><p class="lang-en">Keep expectations flexible: hours and stock are stall-specific. Heat can be stronger, so water and light clothing help.</p></li></ol></div></section>
    <section class="practical" aria-labelledby="practical-title"><div class="section-shell"><div><p class="section-index">05 —</p><p class="eyebrow">Tiện ích thiết yếu</p></div><div><h2 id="practical-title" class="display section-title"><span class="lang-vi">Thông tin thực tế trước khi rẽ vào lối chợ.</span><span class="lang-en">Practical notes before you turn into the market.</span></h2><p class="intro-text lang-vi">Đây là các gợi ý định hướng trung lập, không thay thế tình trạng thực tế tại chỗ. Hãy hỏi nhân viên hoặc biển chỉ dẫn khi cần hỗ trợ.</p><p class="intro-text lang-en">These are neutral orientation notes, not a substitute for conditions on the day. Ask staff or follow posted signs whenever you need help.</p></div></div><div class="field-guide"><article class="field-card"><span class="card-number">01</span><h3><span class="lang-vi">Nhà vệ sinh</span><span class="lang-en">Restrooms</span></h3><p class="lang-vi">Tiện ích có thể nằm trong hoặc gần khu chợ; vị trí và điều kiện sử dụng thay đổi. Hỏi hướng dẫn tại cổng hoặc quầy quản lý.</p><p class="lang-en">Facilities may be inside or close to the market; locations and conditions can vary. Ask at an entrance or management point.</p></article><article class="field-card"><span class="card-number">02</span><h3><span class="lang-vi">Gửi xe</span><span class="lang-en">Parking</span></h3><p class="lang-vi">Khu gửi xe máy hoặc ô tô phụ thuộc cổng, thời điểm và quy định tại chỗ. Không dừng đỗ trên làn xe lưu thông.</p><p class="lang-en">Motorcycle or car parking depends on the entrance, time and on-site rules. Do not stop in active traffic lanes.</p></article><article class="field-card"><span class="card-number">03</span><h3><span class="lang-vi">Ăn uống & lưu trú</span><span class="lang-en">Food & stays</span></h3><p class="lang-vi">Trong khu vực có dạng quầy ăn, chợ thực phẩm và nhiều loại hình lưu trú đô thị. Chúng tôi không xếp hạng hoặc đề xuất cơ sở cụ thể.</p><p class="lang-en">The area includes food stalls, market foods and several forms of urban accommodation. This guide does not rank or endorse specific businesses.</p></article><article class="field-card"><span class="card-number">04</span><h3><span class="lang-vi">Mua sắm thiết yếu</span><span class="lang-en">Essentials</span></h3><p class="lang-vi">Các dịch vụ như cửa hàng tiện lợi, siêu thị, hiệu thuốc và máy rút tiền có thể tìm thấy trong khu đô thị xung quanh.</p><p class="lang-en">Convenience shops, supermarkets, pharmacies and cash points may be found in the surrounding urban area.</p></article><article class="field-card"><span class="card-number">05</span><h3><span class="lang-vi">Nhiên liệu & sạc</span><span class="lang-en">Fuel & charging</span></h3><p class="lang-vi">Người lái xe nên lên kế hoạch nạp nhiên liệu hoặc sạc tại các khu dịch vụ đô thị phù hợp, không dựa vào không gian chợ.</p><p class="lang-en">Drivers should plan fuel or charging at appropriate urban service areas, rather than relying on the market itself.</p></article><article class="field-card"><span class="card-number">06</span><h3><span class="lang-vi">Thanh toán</span><span class="lang-en">Payment</span></h3><p class="lang-vi">Phương thức thanh toán do từng quầy quyết định. Tiền mặt mệnh giá nhỏ giúp việc thanh toán linh hoạt hơn; hãy hỏi giá trước.</p><p class="lang-en">Payment methods are decided by individual stalls. Small-denomination cash can be flexible; ask the price before ordering or buying.</p></article><article class="field-card"><span class="card-number">07</span><h3><span class="lang-vi">Khả năng tiếp cận</span><span class="lang-en">Access</span></h3><p class="lang-vi">Mặt bằng, bậc thềm và độ rộng lối đi thay đổi theo khu. Người cần hỗ trợ di chuyển nên đi cùng người đồng hành và hỏi trước tại chỗ.</p><p class="lang-en">Surfaces, steps and aisle widths vary by section. Visitors who need mobility assistance should travel with a companion and ask on arrival.</p></article><article class="field-card"><span class="card-number">08</span><h3><span class="lang-vi">Tôn trọng không gian</span><span class="lang-en">Shared space</span></h3><p class="lang-vi">Giữ túi gọn, quan sát xe máy ở lối ngoài chợ và xin phép trước khi chụp người khác. Điều này giúp lối đi an toàn hơn cho mọi người.</p><p class="lang-en">Keep bags compact, watch for motorcycles on outer lanes and ask before photographing others. It keeps the space safer for everyone.</p></article></div></section>
    <TransportGuide />
    <section class="tastes" aria-labelledby="food-title"><div class="image-panel"><img src="/con-market-spices.jpg" alt="Thực phẩm và gia vị tại Chợ Cồn (Con Market), Đà Nẵng" width="1024" height="683" loading="lazy" /></div><div class="section-shell"><div><p class="section-index">07 —</p><p class="eyebrow">Ẩm thực quanh chợ</p></div><div><h2 id="food-title" class="display section-title"><span class="lang-vi">Tìm hiểu theo nhóm món, không theo danh sách phải thử.</span><span class="lang-en">Explore by food type, not a must-eat list.</span></h2><p class="intro-text lang-vi">Chợ Cồn thường được nhắc tới cùng văn hóa ăn vặt và nguyên liệu địa phương. Chúng tôi chỉ giới thiệu dạng trải nghiệm để giữ thông tin trung lập, không nêu tên hay khuyến nghị quầy cụ thể.</p><p class="intro-text lang-en">Con Market is commonly associated with local snacks and ingredients. To remain neutral, we describe types of experiences rather than name or recommend individual stalls.</p><div class="food-list"><article class="food-item"><b>01</b><div><h3><span class="lang-vi">Khu món ăn chế biến tại chỗ</span><span class="lang-en">Prepared-food areas</span></h3><p class="lang-vi">Phù hợp khi bạn muốn gọi phần nhỏ và ăn tại chỗ; hỏi thành phần nếu có dị ứng hoặc chế độ ăn riêng.</p><p class="lang-en">Useful for small, eat-on-site portions; ask about ingredients when you have allergies or dietary needs.</p></div></article><article class="food-item"><b>02</b><div><h3><span class="lang-vi">Đồ khô, gia vị & thực phẩm đóng gói</span><span class="lang-en">Dried goods, spices & packaged foods</span></h3><p class="lang-vi">Kiểm tra bao bì, hạn dùng và điều kiện mang theo khi di chuyển bằng máy bay hoặc qua biên giới.</p><p class="lang-en">Check packaging, use-by details and transport rules for air travel or borders.</p></div></article><article class="food-item"><b>03</b><div><h3><span class="lang-vi">Trái cây & nông sản theo mùa</span><span class="lang-en">Seasonal fruit & produce</span></h3><p class="lang-vi">Hãy hỏi giá theo đơn vị, chọn hàng phù hợp thời gian sử dụng và cân nhắc nhiệt độ khi mang đi xa.</p><p class="lang-en">Ask how prices are measured, choose items for your time frame, and consider heat when carrying them away.</p></div></article></div></div></div></section>
    <section class="nearby" aria-labelledby="nearby-title"><div class="section-shell"><div><p class="section-index">08 —</p><p class="eyebrow" style="color:#F3B23C">Tiếp tục chuyến đi</p></div><div><h2 id="nearby-title" class="display section-title"><span class="lang-vi">Ghép chợ vào một vòng đi bộ trong trung tâm.</span><span class="lang-en">Fold the market into a central-city walk.</span></h2><p class="intro-text lang-vi">Các điểm dưới đây thuộc vùng trung tâm rộng hơn. Chọn theo sức đi bộ, thời tiết và giờ mở cửa cập nhật tại nguồn chính thức; không coi đây là thứ tự ưu tiên.</p><p class="intro-text lang-en">The places below sit in the wider central area. Choose by walking comfort, weather and up-to-date official opening information; this is not a ranking.</p></div></div><div class="nearby-grid"><article class="nearby-item"><small><span class="lang-vi">Chợ truyền thống</span><span class="lang-en">Traditional market</span></small><h3><span class="lang-vi">Chợ Hàn</span><span class="lang-en">Hàn Market</span></h3><p class="lang-vi">Một không gian chợ khác ở trung tâm; có thể giúp bạn so sánh nhịp mua bán tại các khu phố khác nhau.</p><p class="lang-en">Another central market setting, offering a comparison with a different part of the city.</p></article><article class="nearby-item"><small><span class="lang-vi">Di sản đô thị</span><span class="lang-en">Urban heritage</span></small><h3><span class="lang-vi">Nhà thờ Chính tòa Đà Nẵng</span><span class="lang-en">Đà Nẵng Cathedral</span></h3><p class="lang-vi">Một điểm kiến trúc trong khu trung tâm, phù hợp để quan sát cảnh quan phố phường từ bên ngoài khi di chuyển.</p><p class="lang-en">A central architectural landmark, suitable for observing the streetscape from the outside while moving through town.</p></article><article class="nearby-item"><small><span class="lang-vi">Bảo tàng</span><span class="lang-en">Museum</span></small><h3><span class="lang-vi">Bảo tàng Điêu khắc Chăm</span><span class="lang-en">Museum of Cham Sculpture</span></h3><p class="lang-vi">Điểm tìm hiểu lịch sử – văn hóa với nhịp tham quan khác hẳn khu chợ; kiểm tra thông tin vé và giờ mở cửa trước chuyến đi.</p><p class="lang-en">A history-and-culture stop with a very different pace from the market; check ticketing and opening details before visiting.</p></article></div></section>

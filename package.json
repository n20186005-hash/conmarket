{
  "name": "con-market-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent visitor guide to Con Market in Vietnamese, English, Chinese and Korean.",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": "22.13.0",
    "pnpm": "10.4.1"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build && node scripts/localize.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "parse5": "8.0.0",
    "typescript": "5.9.3",
    "wrangler": "4.126.0"
  }
}
